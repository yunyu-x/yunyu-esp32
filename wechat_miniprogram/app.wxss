/** app.wxss **/
page {
  background-color: #080c16;
  color: #f0f4f8;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
}

view, text, button, input, scroll-view, canvas {
  box-sizing: border-box;
}

/* 全局重置微信小程序 button 默认的侵入式宽高度与内外边距 */
button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-size: 24rpx;
  text-align: center;
  text-decoration: none;
  line-height: normal;
  border-radius: 12rpx;
  -webkit-tap-highlight-color: transparent;
  overflow: visible;
  width: auto;
  min-height: auto;
  border: none;
  background-color: transparent;
}

button:not([size='mini']) {
  width: auto;
  margin-left: 0;
  margin-right: 0;
  min-height: auto;
}

button::after {
  border: none;
  display: none;
}

/* 全局重置 input 文本框，防止 flex 布局下文字被压扁或上下遮挡 */
input {
  box-sizing: border-box;
  font-family: inherit;
  font-size: 26rpx;
  color: #f8fafc;
  min-width: 0;
}

.input-placeholder {
  color: #64748b;
  font-size: 24rpx;
}
