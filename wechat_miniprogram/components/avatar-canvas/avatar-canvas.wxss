/* wechat_miniprogram/components/avatar-canvas/avatar-canvas.wxss */
.avatar-canvas-container {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background: #000000;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.avatar-canvas-element {
  width: 100%;
  height: 100%;
  display: block;
}

.touch-hint-pill {
  position: absolute;
  bottom: 24rpx;
  background: rgba(44, 44, 46, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid rgba(255, 255, 255, 0.16);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  pointer-events: none;
  animation: hintPop 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  z-index: 10;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.hint-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

@keyframes hintPop {
  0% { opacity: 0; transform: translateY(10rpx) scale(0.92); }
  15% { opacity: 1; transform: translateY(0) scale(1); }
  80% { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-6rpx) scale(0.96); }
}

