<!-- pages/settings/settings.wxml -->
<view class="container">
  <!-- 1. 当前连接状态概览 (双通道硬件感知 HUD) -->
  <view class="status-card">
    <view class="status-top">
      <view class="status-indicators-row">
        <!-- BLE 蓝牙通道标志 -->
        <view class="status-badge {{isBleConnected ? 'badge-ble-connected' : 'badge-ble-disconnected'}}">
          <view class="dot"></view>
          <text>{{isBleConnected ? '⚡ BLE 蓝牙已连接' : '⚪ BLE 蓝牙未连接'}}</text>
        </view>
        <!-- Wi-Fi 联网通道标志 (未联网突出红色断网标志) -->
        <view class="status-badge {{isWifiConnected ? 'badge-wifi-connected' : 'badge-wifi-offline'}}">
          <view class="dot"></view>
          <text>{{isWifiConnected ? '🌐 Wi-Fi 已联网' : '🛑 设备未联网 / 离线'}}</text>
        </view>
      </view>
      <text class="device-tag">{{connectedDeviceName || 'StickS3-Buddy'}}</text>
    </view>

    <!-- 设备未联网醒目警示条 -->
    <view class="net-alert-banner" wx:if="{{!isWifiConnected}}">
      <text class="alert-icon">⚠️</text>
      <text class="alert-msg">StickS3 硬件当前处于断网离线状态，大模型语音对话不可用。请跟随下方第 2 步完成一键配网。</text>
    </view>

    <view class="status-details">
      <view class="detail-col">
        <text class="detail-label">信道模式</text>
        <text class="detail-val">{{currentModeName}}</text>
      </view>
      <view class="detail-col">
        <text class="detail-label">设备 IP</text>
        <text class="detail-val {{isWifiConnected ? 'highlight-cyan' : 'text-offline'}}">{{isWifiConnected ? (deviceStaIp || wifiHost) : '离线断网'}}</text>
      </view>
      <view class="detail-col">
        <text class="detail-label">灵宠等级</text>
        <text class="detail-val highlight-pink">Lv.{{petState.level}}</text>
      </view>
    </view>
  </view>

  <!-- 2. BLE 蓝牙连接管理 -->
  <view class="panel-card">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">⚡ BLE 蓝牙设备连接</text>
        <text class="badge-conn-pill" wx:if="{{isBleConnected}}">已握手成功</text>
      </view>
      <text class="panel-subtitle">GATT 0xFFB0 专属低功耗信道</text>
    </view>

    <!-- 蓝牙当前已连接状态精简摘要卡片 (连接成功后优先展示) -->
    <view class="ble-connected-summary" wx:if="{{isBleConnected}}">
      <view class="ble-summary-left">
        <text class="ble-success-icon">✨</text>
        <view class="ble-summary-text">
          <text class="ble-summary-name">{{connectedDeviceName || 'StickS3-Buddy'}}</text>
          <text class="ble-summary-status">已连接 · 0xFFB0 安全切片通道畅通</text>
        </view>
      </view>
      <view class="ble-summary-actions">
        <button class="btn-disconnect-sub" bindtap="handleDisconnectBle">断开</button>
      </view>
    </view>

    <view class="ble-action-row" wx:if="{{!isBleConnected}}">
      <button 
        class="btn-primary {{isScanning ? 'btn-scanning' : ''}}" 
        bindtap="handleStartBleScan" 
        loading="{{isScanning}}"
      >
        {{isScanning ? '正在扫描设备...' : '🔍 扫描 StickS3-Buddy'}}
      </button>
    </view>

    <!-- 发现的设备列表 (支持折叠与展开收起) -->
    <view class="device-section" wx:if="{{devices.length > 0}}">
      <view class="device-list-header">
        <text class="device-list-count">已扫描到 {{devices.length}} 台蓝牙设备</text>
        <view class="toggle-expand-btn" bindtap="onToggleDeviceListExpanded">
          <text>{{isDeviceListExpanded ? '▲ 收起设备列表' : '▼ 展开全部 (' + devices.length + '台)'}}</text>
        </view>
      </view>

      <view class="device-list">
        <!-- 默认只展示前 2 台推荐设备，展开后显示全部 -->
        <block wx:for="{{devices}}" wx:key="deviceId">
          <view 
            class="device-item {{item.isTarget ? 'device-item-target' : ''}}" 
            wx:if="{{index < 2 || isDeviceListExpanded}}"
          >
            <view class="device-info">
              <view class="device-name-row">
                <text class="device-name">{{item.name || item.localName || 'StickS3-Buddy'}}</text>
                <text class="badge-target-dev" wx:if="{{item.isTarget}}">⭐ 推荐伴侣</text>
              </view>
              <text class="device-id">{{item.deviceId}}</text>
              <text class="device-rssi">信号 RSSI: {{item.RSSI}} dBm</text>
            </view>
            <button 
              class="btn-connect-item" 
              bindtap="handleConnectDevice" 
              data-device-id="{{item.deviceId}}"
              loading="{{connectingId === item.deviceId}}"
            >
              连接
            </button>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 3. Wi-Fi / 手机热点智能配网与流量保护 -->
  <view class="panel-card">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">📶 网络配置与手机热点共享</text>
        <text class="badge-hotspot-tag" wx:if="{{networkMode === 'hotspot'}}">已启用流量保护</text>
      </view>
      <text class="panel-subtitle">BLE 0xFFB4 安全注入凭证</text>
    </view>

    <!-- 配网指引步骤向导 (Step-by-Step Wizard: 4 连续步骤) -->
    <view class="wizard-stepper">
      <!-- 步骤 1: 蓝牙信道 -->
      <view class="wizard-step {{isBleConnected ? 'step-done' : 'step-current'}}">
        <view class="step-num">{{isBleConnected ? '✓' : '1'}}</view>
        <view class="step-content">
          <text class="step-title">蓝牙信道</text>
          <text class="step-desc">{{isBleConnected ? '已连' : '先连上方'}}</text>
        </view>
      </view>
      
      <view class="step-divider {{isBleConnected ? 'divider-active' : ''}}"></view>

      <!-- 步骤 2: 输入账号 -->
      <view class="wizard-step {{isBleConnected ? (wifiSsid ? 'step-done' : 'step-current') : 'step-pending'}}">
        <view class="step-num">{{(isBleConnected && wifiSsid) ? '✓' : '2'}}</view>
        <view class="step-content">
          <text class="step-title">输入账号</text>
          <text class="step-desc">Wi-Fi/热点</text>
        </view>
      </view>

      <view class="step-divider {{(isBleConnected && wifiSsid) ? 'divider-active' : ''}}"></view>

      <!-- 步骤 3: 隔空配网与验证 -->
      <view class="wizard-step {{(deviceStaState === 'connected' || (isBleConnected && isWifiConnected)) ? 'step-done' : (isVerifyingNetwork ? 'step-current' : ((isBleConnected && wifiSsid) ? 'step-current' : 'step-pending'))}}">
        <view class="step-num">{{(deviceStaState === 'connected' || (isBleConnected && isWifiConnected)) ? '✓' : (isVerifyingNetwork ? '⏳' : '3')}}</view>
        <view class="step-content">
          <text class="step-title">配网验证</text>
          <text class="step-desc">{{deviceStaState === 'connected' ? '已联网' : (isVerifyingNetwork ? '验证中' : (isWifiConnected ? '已注入' : '安全下发'))}}</text>
        </view>
      </view>

      <view class="step-divider {{(deviceStaState === 'connected' || (isBleConnected && isWifiConnected)) ? 'divider-active' : ''}}"></view>

      <!-- 步骤 4: 通道就绪 (根据模式自适应) -->
      <view class="wizard-step {{(isWifiConnected || deviceStaState === 'connected') ? 'step-done' : (deviceStaState === 'connecting' ? 'step-current' : 'step-pending')}}">
        <view class="step-num">{{(isWifiConnected || deviceStaState === 'connected') ? '✓' : '4'}}</view>
        <view class="step-content">
          <text class="step-title">{{networkMode === 'hotspot' ? '热点直通' : '局域网直连'}}</text>
          <text class="step-desc">{{(isWifiConnected || deviceStaState === 'connected') ? (networkMode === 'hotspot' ? '云端就绪' : '高速通道') : (networkMode === 'hotspot' ? 'BLE全控' : '极速HTTP')}}</text>
        </view>
      </view>
    </view>

    <!-- 网络模式切换分段器 -->
    <view class="segmented-control">
      <view 
        class="segment-item {{networkMode === 'wifi' ? 'segment-active' : ''}}" 
        bindtap="onSelectNetworkMode" 
        data-mode="wifi"
      >
        <text>🏠 常规 Wi-Fi 宽带</text>
      </view>
      <view 
        class="segment-item {{networkMode === 'hotspot' ? 'segment-active segment-hotspot' : ''}}" 
        bindtap="onSelectNetworkMode" 
        data-mode="hotspot"
      >
        <text>📱 手机共享移动热点</text>
      </view>
    </view>

    <view class="form-group">
      <!-- SSID 输入 -->
      <view class="input-row">
        <text class="input-label">{{networkMode === 'hotspot' ? '手机热点名称 (SSID)' : 'Wi-Fi 名称 (SSID)'}}</text>
        <view class="input-with-action">
          <input 
            class="form-input" 
            placeholder="{{networkMode === 'hotspot' ? '输入个人热点名称' : '输入 2.4GHz Wi-Fi 名称'}}" 
            placeholder-class="input-placeholder"
            value="{{wifiSsid}}" 
            bindinput="onInputSsid"
          />
          <button class="btn-get-wifi" bindtap="handleGetConnectedWifi">获取当前</button>
        </view>
      </view>

      <!-- 密码输入 -->
      <view class="input-row" style="margin-top: 14rpx;">
        <view class="label-with-action">
          <text class="input-label">{{networkMode === 'hotspot' ? '个人热点密码' : 'Wi-Fi 密码'}}</text>
          <text class="pwd-toggle" bindtap="onToggleShowPwd">{{showPwd ? '🙈 隐藏' : '👁️ 显示'}}</text>
        </view>
        <input 
          class="form-input" 
          password="{{!showPwd}}" 
          placeholder="输入连接密码（无密码可留空）" 
          placeholder-class="input-placeholder"
          value="{{wifiPwd}}" 
          bindinput="onInputPwd"
        />
      </view>

      <!-- 手机热点专属流量配额配置区 (仅在热点模式下显示) -->
      <view class="hotspot-config-box" wx:if="{{networkMode === 'hotspot'}}">
        <view class="hotspot-box-header">
          <text class="hotspot-box-title">🛡️ 移动热点流量保护策略</text>
          <text class="hotspot-box-sub">防止大模型语音流推爆手机话费</text>
        </view>

        <!-- 流量预设档位选择器 -->
        <view class="quota-presets-row">
          <view 
            class="quota-chip {{selectedPreset === 50 ? 'quota-chip-active' : ''}}" 
            bindtap="onSelectPreset" 
            data-preset="50"
          >
            <text class="chip-val">50MB</text>
            <text class="chip-desc">轻度体验</text>
          </view>
          <view 
            class="quota-chip {{selectedPreset === 100 ? 'quota-chip-active' : ''}}" 
            bindtap="onSelectPreset" 
            data-preset="100"
          >
            <text class="chip-val">100MB</text>
            <text class="chip-desc">推荐档位</text>
          </view>
          <view 
            class="quota-chip {{selectedPreset === 200 ? 'quota-chip-active' : ''}}" 
            bindtap="onSelectPreset" 
            data-preset="200"
          >
            <text class="chip-val">200MB</text>
            <text class="chip-desc">畅聊陪伴</text>
          </view>
          <view 
            class="quota-chip {{selectedPreset === 500 ? 'quota-chip-active' : ''}}" 
            bindtap="onSelectPreset" 
            data-preset="500"
          >
            <text class="chip-val">500MB</text>
            <text class="chip-desc">长途出行</text>
          </view>
          <view 
            class="quota-chip {{selectedPreset === 'custom' ? 'quota-chip-active' : ''}}" 
            bindtap="onSelectPreset" 
            data-preset="custom"
          >
            <text class="chip-val">自定义</text>
            <text class="chip-desc">MB 上限</text>
          </view>
        </view>

        <!-- 自定义输入 -->
        <view class="custom-limit-row" wx:if="{{selectedPreset === 'custom'}}">
          <text class="custom-limit-label">自定义上限:</text>
          <input 
            class="custom-limit-input" 
            type="number" 
            placeholder="输入 MB 数 (如 150)" 
            placeholder-class="input-placeholder"
            value="{{customLimitInput}}" 
            bindinput="onInputCustomLimit"
          />
          <text class="custom-limit-unit">MB</text>
        </view>

        <view class="current-limit-hint">
          <text>当前设定的流量警戒线：</text>
          <text class="limit-highlight">{{hotspotLimitMb}} MB</text>
        </view>

        <!-- 熔断与预警策略开关 -->
        <view class="policy-switch-row">
          <view class="policy-switch-info">
            <text class="policy-switch-title">超额自动熔断保护</text>
            <text class="policy-switch-desc">达 100% 时自动切断百炼语音推流，保持 BLE 畅通</text>
          </view>
          <switch checked="{{hotspotCutoffEnabled}}" bindchange="onToggleCutoff" color="#ec4899" />
        </view>

        <view class="policy-switch-row" style="border-top: 1px dashed #1e293b; padding-top: 12rpx;">
          <view class="policy-switch-info">
            <text class="policy-switch-title">80% 临界预警心声提醒</text>
            <text class="policy-switch-desc">流量达 80% 时在日记中播报温馨提醒</text>
          </view>
          <switch checked="{{hotspotWarningEnabled}}" bindchange="onToggleWarning" color="#00f2fe" />
        </view>
      </view>

      <!-- 配网引导提示卡片与避坑折叠向导 -->
      <view class="faq-card" bindtap="onToggleWifiFaq">
        <view class="faq-header">
          <text class="faq-icon">💡</text>
          <text class="faq-title">配网指引与常见问题 (点击{{showWifiFaq ? '收起' : '展开'}})</text>
          <text class="faq-arrow">{{showWifiFaq ? '▲' : '▼'}}</text>
        </view>
        <view class="faq-body" wx:if="{{showWifiFaq}}">
          <view class="faq-item">
            <text class="faq-q">Q1: 为什么提示配网失败？</text>
            <text class="faq-a">M5StickS3 仅支持 2.4GHz 频段 Wi-Fi，不支持 5GHz 纯频段。如果路由器是“双频合一”，请在路由后台临时关闭 5G 或保持 2.4G 畅通。</text>
          </view>
          <view class="faq-item">
            <text class="faq-q">Q2: 手机开热点连接注意事项？</text>
            <text class="faq-a">iPhone 用户请在「设置 - 个人热点」中开启「最大化兼容性」；Android 用户请确保热点 AP 频段选择为「2.4GHz 频段」。</text>
          </view>
          <view class="faq-item">
            <text class="faq-q">Q3: 配网凭证如何传输？</text>
            <text class="faq-a">采用严格 20 字节安全 MTU 分片流控，通过 BLE 0xFFB4 特征值加密写入设备 Flash。配网成功后设备将自动连入网络并回显 IP。</text>
          </view>
        </view>
      </view>

      <!-- 配网注入按钮 -->
      <button 
        class="btn-provision {{networkMode === 'hotspot' ? 'btn-provision-hotspot' : ''}} {{!isBleConnected ? 'btn-provision-disabled' : ''}}" 
        bindtap="handleSmartProvision" 
        loading="{{isProvisioning}}"
        disabled="{{isVerifyingNetwork}}"
      >
        {{!isBleConnected ? '⚠️ 请先连接上方 BLE 蓝牙再配网' : (isVerifyingNetwork ? '⏳ 正在验证设备联网...' : (networkMode === 'hotspot' ? '🚀 写入热点配置并连接共享网络' : '🚀 注入凭证并一键配网'))}}
      </button>

      <!-- 配网后设备联网验证进度卡片 -->
      <view class="verify-network-box" wx:if="{{isVerifyingNetwork}}">
        <view class="verify-progress-row">
          <view class="verify-spinner"></view>
          <text class="verify-progress-text">{{verifyProgress || '正在验证设备联网状态...'}}</text>
        </view>
        <text class="verify-hint">凭证已安全写入设备 Flash，正在等待设备连接到 {{networkMode === 'hotspot' ? '手机热点' : 'Wi-Fi 网络'}}...</text>
      </view>

      <!-- 设备联网状态结果卡片 -->
      <view class="device-network-status-card" wx:if="{{deviceStaState}}">
        <view class="net-status-header">
          <text class="net-status-icon">{{deviceStaState === 'connected' ? '✅' : (deviceStaState === 'failed' ? '❌' : (deviceStaState === 'timeout' ? '⏳' : '🔄'))}}</text>
          <view class="net-status-info">
            <text class="net-status-title">{{deviceStaState === 'connected' ? '设备已成功联网' : (deviceStaState === 'failed' ? '设备联网失败' : (deviceStaState === 'timeout' ? '验证超时' : '正在连接...'))}}</text>
            <text class="net-status-ssid" wx:if="{{deviceStaSsid}}">网络: {{deviceStaSsid}}</text>
          </view>
          <button class="btn-refresh-net-status" bindtap="handleCheckDeviceNetwork" loading="{{isVerifyingNetwork}}">
            🔄 刷新
          </button>
        </view>

        <!-- 联网成功详情 -->
        <view class="net-status-details" wx:if="{{deviceStaState === 'connected' && deviceStaIp}}">
          <view class="net-detail-row">
            <text class="net-detail-label">设备 IP</text>
            <text class="net-detail-value highlight-cyan">{{deviceStaIp}}</text>
          </view>
          <view class="net-detail-row">
            <text class="net-detail-label">信号强度</text>
            <text class="net-detail-value {{deviceStaRssi > -60 ? 'highlight-green' : (deviceStaRssi > -75 ? 'highlight-cyan' : 'text-red')}}">{{deviceStaRssi}} dBm</text>
          </view>
        </view>

        <!-- 联网失败提示 -->
        <view class="net-fail-tips" wx:if="{{deviceStaState === 'failed' || deviceStaState === 'timeout'}}">
          <text class="net-fail-tip">💡 请检查: Wi-Fi 名称密码是否正确、是否 2.4GHz 频段、热点是否已开启</text>
        </view>
      </view>

      <!-- 连续性动作 第 4 步：连接通道建立 (根据模式自适应展示) -->

      <!-- 4A. 手机热点专属通道就绪卡片 (热点模式下自动生效，免去局域网直连门槛) -->
      <view class="hotspot-ready-flow-box" wx:if="{{networkMode === 'hotspot'}}">
        <view class="lan-flow-header">
          <view class="lan-flow-title-group">
            <text class="lan-step-pill">第 4 步</text>
            <text class="lan-flow-title">📱 手机热点云端直通就绪</text>
          </view>
          <text class="lan-flow-status {{deviceStaState === 'connected' ? 'status-connected' : (isWifiConnected ? 'status-connected' : 'status-waiting')}}">
            {{deviceStaState === 'connected' ? '● 云端大模型就绪' : (isWifiConnected ? '● 设备已在网' : '○ 待热点连接成功')}}
          </text>
        </view>

        <view class="hotspot-ready-body">
          <view class="ready-badge-row">
            <text class="ready-chip">⚡ BLE 蓝牙实时控制</text>
            <text class="ready-chip">🌐 共享网络直通百炼</text>
            <text class="ready-chip">🛡️ 智能防爆流量熔断</text>
          </view>
          <text class="ready-explain-text">
            💡 <text class="highlight-cyan">无需建立局域网直连：</text>在手机热点模式下，StickS3 硬件直接通过手机共享的网络与阿里云百炼大模型服务器握手推流。小程序全程通过低功耗蓝牙 (BLE) 实施毫秒级控制与流量计量。
          </text>
          <view class="ready-device-info-bar" wx:if="{{deviceStaState === 'connected' || isWifiConnected}}">
            <text class="ready-info-item">设备热点内网 IP: <text class="highlight-cyan">{{deviceStaIp || wifiHost}}</text></text>
            <text class="ready-info-item">信号: <text class="highlight-green">{{deviceStaRssi || -50}} dBm</text></text>
          </view>
        </view>
      </view>

      <!-- 4B. 常规 Wi-Fi 宽带模式：局域网高速通道直连 (配网与直连一体化) -->
      <view class="lan-direct-flow-box" wx:if="{{networkMode === 'wifi'}}">
        <view class="lan-flow-header">
          <view class="lan-flow-title-group">
            <text class="lan-step-pill">第 4 步</text>
            <text class="lan-flow-title">🌐 局域网高速通道直连</text>
          </view>
          <text class="lan-flow-status {{deviceStaState === 'connected' ? 'status-connected' : (isWifiConnected ? 'status-connected' : 'status-waiting')}}">
            {{deviceStaState === 'connected' ? '● 设备已联网就绪' : (isWifiConnected ? '● 设备已在网' : '○ 待设备入网分配IP')}}
          </text>
        </view>
        <text class="lan-flow-desc">{{deviceStaState === 'connected' ? '设备已在局域网内分配到 IP，已自动填入，点击下方按钮即可建立全双工高速通道' : '配网注入后设备将自动联网并获取局域网 IP，输入 IP 即可建立全双工极速通道'}}</text>

        <view class="input-row" style="margin-top: 10rpx;">
          <text class="input-label">硬件局域网 IP</text>
          <input 
            class="form-input" 
            placeholder="如 192.168.1.100" 
            placeholder-class="input-placeholder"
            value="{{wifiHostInput}}" 
            bindinput="onInputHost"
          />
        </view>

        <view class="wifi-action-grid">
          <button class="btn-wifi-test" bindtap="handleTestWifiConnection" loading="{{isTestingWifi}}">
            ⚡ 测试连通性
          </button>
          <button class="btn-wifi-connect {{isWifiConnected ? 'btn-active-wifi' : ''}}" bindtap="handleToggleWifiConnection">
            {{isWifiConnected ? '断开局域网' : '🌐 直连局域网通道'}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 4. 手机热点实时流量遥测与控制看板 -->
  <view class="panel-card traffic-panel" wx:if="{{hotspot.isHotspot || networkMode === 'hotspot'}}">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">📊 手机热点流量监控看板</text>
        <view class="traffic-status-badge {{hotspot.cutoffActive ? 'status-cutoff' : (trafficPercent >= 80 ? 'status-warn' : 'status-normal')}}">
          <text>{{hotspot.cutoffActive ? '🛑 已触发熔断保护' : (trafficPercent >= 80 ? '⚠️ 临界预警中' : '🟢 流量健康')}}</text>
        </view>
      </view>
      <text class="panel-subtitle">ESP32 硬件级实时计量</text>
    </view>

    <!-- 流量进度条与占比 -->
    <view class="traffic-gauge-box">
      <view class="gauge-top-row">
        <text class="gauge-label">流量消耗进度</text>
        <text class="gauge-percent {{hotspot.cutoffActive ? 'text-red' : (trafficPercent >= 80 ? 'text-amber' : 'text-cyan')}}">{{trafficPercent}}%</text>
      </view>
      <view class="gauge-bar-bg">
        <view 
          class="gauge-bar-fill {{hotspot.cutoffActive ? 'bar-red' : (trafficPercent >= 80 ? 'bar-amber' : 'bar-cyan')}}" 
          style="width: {{trafficPercent}}%;"
        ></view>
      </view>
    </view>

    <!-- 遥测数据三联格 -->
    <view class="traffic-metrics-grid">
      <view class="metric-card">
        <text class="metric-label">已消耗数据</text>
        <text class="metric-val highlight-cyan">{{hotspot.usedMb}} <text class="metric-unit">MB</text></text>
      </view>
      <view class="metric-card">
        <text class="metric-label">剩余安全配额</text>
        <text class="metric-val {{hotspot.remainingMb <= 10 ? 'text-red' : 'highlight-green'}}">{{hotspot.remainingMb}} <text class="metric-unit">MB</text></text>
      </view>
      <view class="metric-card">
        <text class="metric-label">保护额度上限</text>
        <text class="metric-val highlight-pink">{{hotspot.limitMb}} <text class="metric-unit">MB</text></text>
      </view>
    </view>

    <!-- 熔断状态特别提示条 -->
    <view class="cutoff-notice-box" wx:if="{{hotspot.cutoffActive}}">
      <text class="notice-icon">🛑</text>
      <view class="notice-text">
        <text class="notice-title">全双工音频推流已安全熔断</text>
        <text class="notice-sub">已消耗 {{hotspot.usedMb}}MB 达到设定的 {{hotspot.limitMb}}MB 上限。点击下方“追加 50MB”即可立即恢复大模型语音对话。</text>
      </view>
    </view>

    <!-- 流量管理快捷操作栏 -->
    <view class="traffic-actions-row">
      <button class="btn-traffic-action btn-refresh" bindtap="handleRefreshTraffic">
        🔄 刷新流量
      </button>
      <button class="btn-traffic-action btn-add-quota" bindtap="handleAddQuota">
        ➕ 追加 50MB
      </button>
      <button class="btn-traffic-action btn-reset" bindtap="handleResetTraffic">
        0️⃣ 重置统计
      </button>
    </view>
  </view>

  <!-- 5. 阿里云百炼大模型交互设置 -->
  <view class="panel-card bailian-panel">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">🤖 阿里云百炼大模型配置</text>
        <view class="traffic-status-badge {{hasBailianKey ? 'status-normal' : 'status-warn'}}">
          <text>{{hasBailianKey ? '🟢 Key 已配置' : '⚠️ 待输入 Key'}}</text>
        </view>
      </view>
      <text class="panel-subtitle">DashScope Realtime 全双工端到端语音大模型</text>
    </view>

    <!-- API Key 输入框 -->
    <view class="input-row" style="margin-top: 8rpx;">
      <view class="label-with-action">
        <text class="input-label">DashScope API Key</text>
        <text class="pwd-toggle" bindtap="onToggleShowBailianKey">{{showBailianKey ? '🙈 隐藏' : '👁️ 显示'}}</text>
      </view>
      <input 
        class="form-input" 
        password="{{!showBailianKey}}" 
        placeholder="{{maskedBailianKey ? ('已保存: ' + maskedBailianKey) : '输入百炼 API Key (sk-xxxx...)'}}" 
        placeholder-class="input-placeholder"
        value="{{bailianKeyInput}}" 
        bindinput="onInputBailianKey"
      />
    </view>

    <!-- 实时大模型选择 (Picker) -->
    <view class="input-row" style="margin-top: 14rpx;">
      <text class="input-label">实时语音大模型 (Model)</text>
      <picker bindchange="onModelChange" value="{{selectedModelIndex}}" range="{{modelOptions}}" range-key="label">
        <view class="picker-display-box">
          <text class="picker-current-text">{{modelOptions[selectedModelIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 对话音色选择 (Picker + 试听按钮) -->
    <view class="input-row" style="margin-top: 14rpx;">
      <text class="input-label">拟人发声音色 (Voice)</text>
      <view class="voice-picker-row">
        <picker class="voice-picker" bindchange="onVoiceChange" value="{{selectedVoiceIndex}}" range="{{voiceOptions}}" range-key="label">
          <view class="picker-display-box">
            <text class="picker-current-text">{{voiceOptions[selectedVoiceIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
        <button class="btn-voice-preview {{isPreviewingVoice ? 'btn-voice-playing' : ''}}" bindtap="handlePreviewVoice" loading="{{isPreviewingVoice}}">
          {{isPreviewingVoice ? '⏹ 播放中' : '🔊 试听'}}
        </button>
      </view>
    </view>

    <!-- 伴侣硬件播音音量调节 (Slider + 防破音黄金区间提示) -->
    <view class="input-row" style="margin-top: 14rpx;">
      <view class="label-with-action">
        <text class="input-label">硬件播音音量 (Speaker Volume)</text>
        <view style="display: flex; align-items: center; gap: 12rpx;">
          <text class="volume-val-badge">{{speakerVolume}}%</text>
          <button class="btn-preset-chip" style="margin: 0; padding: 4rpx 14rpx; font-size: 20rpx; height: 44rpx; line-height: 44rpx; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1rpx solid rgba(56, 189, 248, 0.4);" bindtap="handleTestVolume">🔊 试听音量</button>
        </view>
      </view>
      <slider 
        class="volume-slider" 
        min="10" 
        max="100" 
        step="5" 
        value="{{speakerVolume}}" 
        bindchange="onVolumeChange"
        bindchanging="onVolumeChanging"
        activeColor="#06b6d4" 
        backgroundColor="#334155" 
        block-size="20"
        block-color="#38bdf8"
      />
      <text class="prompt-hint" style="margin-top: -6rpx;">💡 建议 65%~75% 黄金区间：保护微型扬声器防止机械破音，并消除回声干扰</text>
    </view>

    <!-- 人格提示词 (Prompt) 输入与预设标签 -->
    <view class="input-row" style="margin-top: 14rpx;">
      <view class="label-with-action">
        <text class="input-label">人格提示词 (System Prompt)</text>
        <text class="prompt-hint">控制伴侣说话口吻与长度</text>
      </view>
      <textarea 
        class="form-textarea" 
        placeholder="设定灵宠的人格提示词..." 
        placeholder-class="input-placeholder"
        value="{{bailianPrompt}}" 
        bindinput="onInputPrompt"
        maxlength="250"
      />
    </view>

    <!-- 预设标签快速填入 -->
    <view class="prompt-presets-row">
      <text class="preset-label">快捷预设:</text>
      <view class="preset-tags">
        <view 
          class="preset-tag" 
          wx:for="{{promptPresets}}" 
          wx:key="name" 
          bindtap="handleApplyPromptPreset" 
          data-prompt="{{item.prompt}}"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <button class="btn-save-bailian" bindtap="handleSaveBailianConfig" loading="{{isSavingBailian}}">
      💾 保存大模型配置到设备 Flash
    </button>
  </view>

  <!-- 6. 离线唤醒词「悄悄」配置 -->
  <view class="panel-card wakeword-panel">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">🗣️ 离线唤醒词「悄悄」配置</text>
        <view class="traffic-status-badge {{wakewordEnabled ? 'status-normal' : 'status-cutoff'}}">
          <text>{{wakewordEnabled ? '🟢 离线拾音监听中' : '⚪ 已停用'}}</text>
        </view>
      </view>
      <text class="panel-subtitle">ESP32-S3 本地共振特征双二阶滤波毫秒级识别</text>
    </view>

    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">启用离线唤醒词检测</text>
        <text class="setting-desc">常态静默监听呼唤「悄悄」，随时唤醒并打断放音</text>
      </view>
      <switch checked="{{wakewordEnabled}}" bindchange="onToggleWakeword" color="#30D158" />
    </view>

    <!-- 灵敏度调节滑块 -->
    <view class="slider-row" wx:if="{{wakewordEnabled}}">
      <view class="slider-header">
        <text class="slider-title">唤醒识别灵敏度</text>
        <text class="slider-val highlight-cyan">{{wakewordSensitivity}}%</text>
      </view>
      <slider 
        min="20" 
        max="100" 
        step="5" 
        value="{{wakewordSensitivity}}" 
        bindchange="onWakewordSensitivityChange"
        activeColor="#00f2fe"
        backgroundColor="rgba(255,255,255,0.15)"
        block-size="20"
      />
      <text class="slider-desc">灵敏度过高可能引发环境噪音误触，推荐设定在 70% ~ 80%</text>
    </view>

    <!-- 对话等待推流窗口 -->
    <view class="input-row" style="margin-top: 14rpx;" wx:if="{{wakewordEnabled}}">
      <text class="input-label">唤醒后等待说话推流窗口</text>
      <picker bindchange="onTimeoutChange" value="{{selectedTimeoutIndex}}" range="{{timeoutOptions}}">
        <view class="picker-display-box">
          <text class="picker-current-text">{{timeoutOptions[selectedTimeoutIndex]}} 秒超时关闭推流</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 唤醒配置操作按钮组 -->
    <view class="wakeword-actions-row">
      <button class="btn-save-wakeword" bindtap="handleSaveWakewordConfig" loading="{{isSavingWakeword}}">
        💾 保存唤醒配置
      </button>
      <button class="btn-test-wake" bindtap="handleTriggerWakeSim" loading="{{isTriggeringWake}}">
        🎙️ 隔空模拟唤醒
      </button>
    </view>
  </view>

  <!-- 7. 设备维护、信息重置与出厂恢复 -->
  <view class="panel-card maintenance-panel">
    <view class="panel-header">
      <view class="panel-title-group">
        <text class="panel-title">🛠️ 设备维护与信息重置</text>
      </view>
      <text class="panel-subtitle">物理硬件多维度运维、长程记忆抹除与出厂擦除</text>
    </view>

    <!-- 1. 清空设备对话记忆 -->
    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">清空设备长程对话记忆</text>
        <text class="setting-desc">抹除 StickS3 Flash NVS 命名空间 sticks3_mem</text>
      </view>
      <button class="btn-warn-sub" bindtap="handleClearDeviceMemory" loading="{{isClearingMemory}}">清空记忆</button>
    </view>

    <!-- 2. 远程软重启设备 -->
    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">远程软重启设备</text>
        <text class="setting-desc">触发 esp_restart() 重新启动固件，保留 Wi-Fi 与 Key 配置</text>
      </view>
      <button class="btn-ctrl-sub" bindtap="handleDeviceReboot" loading="{{isRebootingDevice}}">重启设备</button>
    </view>

    <!-- 3. 一键恢复出厂设置 -->
    <view class="setting-row" style="border-bottom: none;">
      <view class="setting-info">
        <text class="setting-title text-red">一键恢复出厂设置 (Factory Reset)</text>
        <text class="setting-desc">抹除所有 Wi-Fi、Key、流量统计与全部配置，恢复初始待命态</text>
      </view>
      <button class="btn-danger-sub" bindtap="handleDeviceFactoryReset" loading="{{isFactoryResetting}}">出厂重置</button>
    </view>

    <view class="physical-reset-hint">
      <text class="hint-title">💡 物理实体按键重置方式：</text>
      <text class="hint-body">在 StickS3 设备开机状态下，同时长按【正面按键 A】与【侧面按键 B】保持 4 秒，听到蜂鸣提示后即可无视网络直接硬件恢复出厂设置！</text>
    </view>
  </view>

  <!-- 8. 偏好与系统设置 -->
  <view class="panel-card">
    <view class="panel-header">
      <text class="panel-title">⚙️ 系统偏好与控制</text>
    </view>

    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">真机触觉微震动反馈</text>
        <text class="setting-desc">投喂、抚摸与击掌时的 Taptic / 线性马达震感</text>
      </view>
      <switch checked="{{vibrationEnabled}}" bindchange="onToggleVibration" color="#00f2fe" />
    </view>

    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">切换硬件屏显模式</text>
        <text class="setting-desc">在灵宠迪士尼表情与系统遥测仪表盘间切换</text>
      </view>
      <button class="btn-ctrl-sub" bindtap="handleToggleAvatarMode">切换模式</button>
    </view>

    <view class="setting-row">
      <view class="setting-info">
        <text class="setting-title">清除本地离线缓存</text>
        <text class="setting-desc">重置本地心声日记与存储历史</text>
      </view>
      <button class="btn-danger-sub" bindtap="handleClearStorage">清空日记</button>
    </view>
  </view>

  <!-- 6. 固件契约与版本诊断 -->
  <view class="panel-card info-card">
    <text class="info-title">🛠️ 固件与通信契约诊断</text>
    <view class="info-item">
      <text class="info-lbl">固件版本：</text>
      <text class="info-val">v1.0.0-mobile (ESP32-S3-PICO-1)</text>
    </view>
    <view class="info-item">
      <text class="info-lbl">专属服务：</text>
      <text class="info-val">0000FFB0-0000-1000-8000-00805F9B34FB</text>
    </view>
    <view class="info-item">
      <text class="info-lbl">特征值体系：</text>
      <text class="info-val">0xFFB1 记忆 / 0xFFB2 状态 / 0xFFB3 日记 / 0xFFB4 注入</text>
    </view>
    <view class="info-item">
      <text class="info-lbl">流控安全规则：</text>
      <text class="info-val">严格 20 字节安全 MTU 分片与 20ms 节奏延时</text>
    </view>
  </view>
</view>
