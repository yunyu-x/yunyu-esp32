/* pages/settings/settings.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 50rpx;
}

/* 顶部状态卡片 */
.status-card {
  background: #121929;
  border: 1px solid rgba(0, 242, 254, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.status-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-online {
  background: rgba(0, 230, 118, 0.15);
  border: 1px solid #00e676;
  color: #00e676;
}

.badge-offline {
  background: rgba(148, 163, 184, 0.15);
  border: 1px solid #64748b;
  color: #94a3b8;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
}

.device-tag {
  font-size: 20rpx;
  color: #64748b;
}

.status-details {
  display: flex;
  justify-content: space-around;
  border-top: 1px solid #1e293b;
  padding-top: 16rpx;
}

.detail-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.detail-label {
  font-size: 20rpx;
  color: #64748b;
}

.detail-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #cbd5e1;
}

.highlight-pink {
  color: #f472b6;
}

/* 通用面板卡片 */
.panel-card {
  background: #121929;
  border: 1px solid #1e293b;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 1px solid #1e293b;
  padding-bottom: 12rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #00f2fe;
}

.panel-subtitle {
  font-size: 20rpx;
  color: #64748b;
}

/* BLE 扫描 */
.ble-action-row {
  display: flex;
  gap: 14rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 14rpx;
  border: none;
  padding: 16rpx 0;
  line-height: normal;
}

.btn-scanning {
  opacity: 0.8;
}

.btn-outline {
  background: #1e293b;
  border: 1px solid #475569;
  color: #f87171;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 16rpx 28rpx;
  line-height: normal;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8fafc;
}

.device-id {
  font-size: 18rpx;
  color: #64748b;
}

.device-rssi {
  font-size: 18rpx;
  color: #38bdf8;
}

.btn-connect-item {
  background: #0284c7;
  color: white;
  font-size: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  line-height: normal;
  border: none;
  margin: 0;
}

/* 表单输入组件 */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.input-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.form-input {
  background: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #f8fafc;
}

.input-with-action {
  display: flex;
  gap: 12rpx;
}

.input-with-action .form-input {
  flex: 1;
}

.btn-get-wifi {
  background: #1e293b;
  border: 1px solid #475569;
  color: #38bdf8;
  font-size: 20rpx;
  border-radius: 14rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  margin: 0;
}

.form-tip {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.btn-provision {
  background: linear-gradient(135deg, #ec4899, #d946ef);
  color: white;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  padding: 18rpx 0;
  line-height: normal;
}

/* Wi-Fi 动作格 */
.wifi-action-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.btn-wifi-test, .btn-wifi-connect {
  flex: 1;
  background: #1e293b;
  border: 1px solid #334155;
  color: #cbd5e1;
  font-size: 22rpx;
  border-radius: 14rpx;
  padding: 16rpx 0;
  line-height: normal;
}

.btn-active-wifi {
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: white;
  border: none;
}

/* 系统偏好行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1px solid #1a2234;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  padding-right: 16rpx;
}

.setting-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #f8fafc;
}

.setting-desc {
  font-size: 20rpx;
  color: #64748b;
}

.btn-ctrl-sub {
  background: #1e293b;
  color: #38bdf8;
  font-size: 20rpx;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  border: 1px solid rgba(56, 189, 248, 0.4);
  line-height: normal;
  margin: 0;
}

.btn-danger-sub {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  font-size: 20rpx;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  border: 1px solid rgba(239, 68, 68, 0.4);
  line-height: normal;
  margin: 0;
}

/* 诊断信息卡片 */
.info-card {
  background: #090e1a;
  border: 1px solid #1e293b;
  font-size: 20rpx;
}

.info-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.info-lbl {
  color: #64748b;
  width: 140rpx;
  flex-shrink: 0;
}

.info-val {
  color: #94a3b8;
  word-break: break-all;
}

/* ===================================================
 * 手机热点与流量保护新增样式 (Glassmorphism & Cyberpunk)
 * =================================================== */

.panel-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge-hotspot-tag {
  background: rgba(236, 72, 153, 0.15);
  border: 1px solid #ec4899;
  color: #f472b6;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* 分段网络切换器 */
.segmented-control {
  display: flex;
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 16rpx;
  padding: 6rpx;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.segment-active {
  background: #1e293b;
  color: #38bdf8;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.segment-hotspot {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.25), rgba(168, 85, 247, 0.25));
  color: #f472b6;
  border: 1px solid rgba(236, 72, 153, 0.4);
}

.label-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pwd-toggle {
  font-size: 20rpx;
  color: #38bdf8;
  cursor: pointer;
}

/* 手机热点配额设置框 */
.hotspot-config-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(236, 72, 153, 0.3);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 6rpx;
}

.hotspot-box-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.hotspot-box-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #f472b6;
}

.hotspot-box-sub {
  font-size: 18rpx;
  color: #94a3b8;
}

/* 配额预设芯片网格 */
.quota-presets-row {
  display: flex;
  gap: 10rpx;
}

.quota-chip {
  flex: 1;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 12rpx;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  transition: all 0.2s ease;
}

.quota-chip-active {
  background: rgba(236, 72, 153, 0.2);
  border-color: #ec4899;
}

.chip-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
}

.quota-chip-active .chip-val {
  color: #f472b6;
}

.chip-desc {
  font-size: 16rpx;
  color: #64748b;
}

.custom-limit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.custom-limit-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.custom-limit-input {
  flex: 1;
  color: #f8fafc;
  font-size: 24rpx;
}

.custom-limit-unit {
  font-size: 22rpx;
  color: #f472b6;
  font-weight: 700;
}

.current-limit-hint {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.limit-highlight {
  font-weight: 700;
  color: #f472b6;
}

/* 策略开关行 */
.policy-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.policy-switch-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  padding-right: 16rpx;
}

.policy-switch-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #f8fafc;
}

.policy-switch-desc {
  font-size: 18rpx;
  color: #64748b;
}

.btn-provision-hotspot {
  background: linear-gradient(135deg, #ec4899, #8b5cf6);
  box-shadow: 0 4rpx 14rpx rgba(236, 72, 153, 0.4);
}

/* 流量监控看板卡片 */
.traffic-panel {
  border: 1px solid rgba(236, 72, 153, 0.35);
  background: #0d1527;
}

.traffic-status-badge {
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 700;
}

.status-normal {
  background: rgba(0, 230, 118, 0.15);
  color: #00e676;
  border: 1px solid rgba(0, 230, 118, 0.4);
}

.status-warn {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border: 1px solid rgba(245, 158, 11, 0.4);
}

.status-cutoff {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.5);
  animation: pulse-border 1.5s infinite;
}

@keyframes pulse-border {
  0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
  70% { box-shadow: 0 0 0 10rpx rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

/* 进度条 */
.traffic-gauge-box {
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gauge-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gauge-label {
  font-size: 20rpx;
  color: #94a3b8;
}

.gauge-percent {
  font-size: 28rpx;
  font-weight: 800;
}

.gauge-bar-bg {
  width: 100%;
  height: 14rpx;
  background: #1e293b;
  border-radius: 7rpx;
  overflow: hidden;
}

.gauge-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.4s ease;
}

.bar-cyan {
  background: linear-gradient(90deg, #00f2fe, #4facfe);
}

.bar-amber {
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
}

.bar-red {
  background: linear-gradient(90deg, #f87171, #ef4444);
}

.text-cyan { color: #00f2fe; }
.text-amber { color: #f59e0b; }
.text-red { color: #ef4444; }
.highlight-green { color: #00e676; }

/* 遥测三联格 */
.traffic-metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.metric-card {
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.metric-label {
  font-size: 18rpx;
  color: #64748b;
}

.metric-val {
  font-size: 26rpx;
  font-weight: 800;
}

.metric-unit {
  font-size: 18rpx;
  font-weight: 400;
  color: #94a3b8;
}

/* 熔断告警卡 */
.cutoff-notice-box {
  background: rgba(239, 68, 68, 0.12);
  border: 1px solid rgba(239, 68, 68, 0.4);
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.notice-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #f87171;
}

.notice-sub {
  font-size: 18rpx;
  color: #cbd5e1;
  line-height: 1.4;
}

/* 快捷操作栏 */
.traffic-actions-row {
  display: flex;
  gap: 12rpx;
}

.btn-traffic-action {
  flex: 1;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 14rpx 0;
  line-height: normal;
  border: none;
}

.btn-refresh {
  background: #1e293b;
  color: #cbd5e1;
  border: 1px solid #334155;
}

.btn-add-quota {
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: white;
}

.btn-reset {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.35);
}
