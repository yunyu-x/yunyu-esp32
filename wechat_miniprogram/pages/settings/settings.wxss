/* pages/settings/settings.wxss - Apple HIG Dark Mode Grouped Settings Aesthetic */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 60rpx;
  background-color: var(--ios-bg, #000000);
}

/* ================= 1. 顶部当前连接状态概览 (Apple Status Widget) ================= */
.status-card {
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.status-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-indicators-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.badge-online {
  background: rgba(48, 209, 88, 0.15);
  border: 0.5px solid rgba(48, 209, 88, 0.4);
  color: #30D158;
}

.badge-offline {
  background: rgba(142, 142, 147, 0.12);
  border: 0.5px solid rgba(142, 142, 147, 0.25);
  color: #8E8E93;
}

.badge-ble-connected {
  background: rgba(10, 132, 255, 0.15);
  border: 0.5px solid rgba(10, 132, 255, 0.4);
  color: #0A84FF;
}

.badge-ble-disconnected {
  background: rgba(142, 142, 147, 0.12);
  border: 0.5px solid rgba(142, 142, 147, 0.25);
  color: #8E8E93;
}

.badge-wifi-connected {
  background: rgba(48, 209, 88, 0.15);
  border: 0.5px solid rgba(48, 209, 88, 0.4);
  color: #30D158;
}

.badge-wifi-offline {
  background: rgba(255, 69, 58, 0.15);
  border: 0.5px solid rgba(255, 69, 58, 0.4);
  color: #FF453A;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.device-tag {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.net-alert-banner {
  background: rgba(255, 69, 58, 0.12);
  border: 0.5px solid rgba(255, 69, 58, 0.35);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.alert-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.alert-msg {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1.45;
}

.status-details {
  display: flex;
  justify-content: space-around;
  border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  padding-top: 18rpx;
}

.detail-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.detail-label {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.detail-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.text-offline {
  color: #FF453A;
  font-weight: 600;
}

.highlight-cyan {
  color: #64D2FF;
}

.highlight-pink {
  color: #FF375F;
}

.highlight-green {
  color: #30D158;
}

.text-red {
  color: #FF453A;
}

/* ================= 通用面板卡片 (Apple Inset Grouped) ================= */
.panel-card {
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 14rpx;
}

.panel-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.3rpx;
}

.panel-subtitle {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.badge-conn-pill {
  background: rgba(48, 209, 88, 0.15);
  border: 0.5px solid rgba(48, 209, 88, 0.4);
  color: #30D158;
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.badge-hotspot-tag {
  background: rgba(255, 159, 10, 0.15);
  border: 0.5px solid rgba(255, 159, 10, 0.4);
  color: #FF9F0A;
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* ================= 2. BLE 蓝牙连接管理 ================= */
.ble-action-row {
  display: flex;
  gap: 14rpx;
}

.btn-primary {
  flex: 1;
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  height: 80rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  box-shadow: 0 4rpx 16rpx rgba(10, 132, 255, 0.35);
}

.btn-scanning {
  opacity: 0.75;
}

.ble-connected-summary {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ble-summary-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.ble-success-icon {
  font-size: 32rpx;
}

.ble-summary-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ble-summary-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.ble-summary-status {
  font-size: 20rpx;
  color: #64D2FF;
}

.ble-summary-actions {
  display: flex;
  align-items: center;
}

.btn-disconnect-sub {
  background: rgba(255, 69, 58, 0.15);
  border: 0.5px solid rgba(255, 69, 58, 0.35);
  color: #FF453A;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 10rpx 26rpx;
  line-height: normal;
  width: auto !important;
  margin: 0;
}

.device-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.device-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}

.device-list-count {
  font-size: 22rpx;
  color: var(--ios-label-secondary, #8E8E93);
  font-weight: 500;
}

.toggle-expand-btn {
  font-size: 22rpx;
  color: var(--ios-blue, #0A84FF);
  padding: 6rpx 16rpx;
  background: rgba(10, 132, 255, 0.12);
  border-radius: 12rpx;
  cursor: pointer;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 6rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  gap: 16rpx;
}

.device-item-target {
  border-color: rgba(10, 132, 255, 0.4);
  background: rgba(44, 44, 46, 0.95);
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.device-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.device-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.badge-target-dev {
  background: rgba(10, 132, 255, 0.15);
  border: 0.5px solid rgba(10, 132, 255, 0.35);
  color: #0A84FF;
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.device-id {
  font-size: 20rpx;
  color: var(--ios-label-tertiary, #636366);
  word-break: break-all;
}

.device-rssi {
  font-size: 20rpx;
  color: #64D2FF;
  font-weight: 500;
}

.btn-connect-item {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  width: auto !important;
  flex-shrink: 0;
}

/* ================= 3. 配网向导与参数输入 (Apple HIG Form) ================= */
.wizard-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.wizard-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.step-title {
  font-size: 22rpx;
  font-weight: 600;
}

.step-desc {
  font-size: 16rpx;
  color: var(--ios-label-secondary, #8E8E93);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.step-done .step-num {
  background: #30D158;
  color: #000000;
}

.step-done .step-title {
  color: #30D158;
}

.step-current .step-num {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
}

.step-current .step-title {
  color: var(--ios-blue, #0A84FF);
}

.step-pending .step-num {
  background: var(--ios-quaternary-bg, #3A3A3C);
  color: var(--ios-label-tertiary, #636366);
}

.step-pending .step-title {
  color: var(--ios-label-tertiary, #636366);
}

.step-divider {
  height: 2rpx;
  background: var(--ios-quaternary-bg, #3A3A3C);
  flex: 0.35;
  margin: 0 8rpx;
}

.divider-active {
  background: #30D158;
}

/* 分段网络模式切换器 (Apple HIG Segmented Control) */
.segmented-control {
  display: flex;
  background: #000000;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ios-label-secondary, #8E8E93);
  border-radius: 999rpx;
  transition: all 0.2s cubic-bezier(0.2, 0.9, 0.4, 1);
}

.segment-active {
  background: var(--ios-tertiary-bg, #2C2C2E);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.segment-hotspot {
  color: #FF9F0A;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  width: 100%;
}

.label-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pwd-toggle {
  font-size: 22rpx;
  color: var(--ios-blue, #0A84FF);
  cursor: pointer;
}

.input-label {
  font-size: 24rpx;
  color: var(--ios-label-secondary, #8E8E93);
  font-weight: 500;
}

.form-input {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  padding: 0 24rpx;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
}

.input-with-action {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
}

.input-with-action .form-input {
  flex: 1;
  min-width: 0;
}

.btn-get-wifi {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.1);
  color: var(--ios-blue, #0A84FF);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 0 28rpx;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  width: auto !important;
  margin: 0;
}

/* ================= 手机热点专属流量保护配置区 ================= */
.hotspot-config-box {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hotspot-box-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hotspot-box-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF9F0A;
}

.hotspot-box-sub {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.quota-presets-row {
  display: flex;
  gap: 10rpx;
}

.quota-chip {
  flex: 1;
  background: var(--ios-quaternary-bg, #3A3A3C);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 12rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  transition: all 0.15s ease;
}

.chip-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.chip-desc {
  font-size: 16rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.quota-chip-active {
  background: var(--ios-blue, #0A84FF);
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(10, 132, 255, 0.35);
}

.quota-chip-active .chip-desc {
  color: rgba(255, 255, 255, 0.8);
}

.custom-limit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.custom-limit-label {
  font-size: 22rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.custom-limit-input {
  flex: 1;
  background: #000000;
  border: 0.5px solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 0 18rpx;
  height: 64rpx;
  min-height: 64rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}

.custom-limit-unit {
  font-size: 22rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.current-limit-hint {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--ios-label-secondary, #8E8E93);
  gap: 6rpx;
}

.limit-highlight {
  color: #FF9F0A;
  font-weight: 700;
}

.policy-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.policy-switch-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  padding-right: 16rpx;
}

.policy-switch-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.policy-switch-desc {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

/* ================= FAQ 折叠指引 ================= */
.faq-card {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.faq-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.faq-icon {
  font-size: 28rpx;
}

.faq-title {
  flex: 1;
}

.faq-arrow {
  font-size: 22rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.faq-body {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  padding-top: 14rpx;
}

.faq-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.faq-q {
  font-size: 22rpx;
  font-weight: 600;
  color: #64D2FF;
}

.faq-a {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  line-height: 1.45;
}

/* 配网注入大按钮 */
.btn-provision {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 22rpx;
  border: none;
  height: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 0;
  box-shadow: 0 4rpx 16rpx rgba(10, 132, 255, 0.35);
}

.btn-provision-hotspot {
  background: linear-gradient(135deg, #FF9F0A, #FF375F);
  box-shadow: 0 4rpx 16rpx rgba(255, 159, 10, 0.35);
}

.btn-provision-disabled {
  opacity: 0.45;
}

/* 验证中状态卡片 */
.verify-network-box {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.verify-progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.verify-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: var(--ios-blue, #0A84FF);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.verify-progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.verify-hint {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

/* 设备联网状态结果卡片 */
.device-network-status-card {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.net-status-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.net-status-icon {
  font-size: 32rpx;
}

.net-status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.net-status-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.net-status-ssid {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.btn-refresh-net-status {
  background: var(--ios-quaternary-bg, #3A3A3C);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  width: auto !important;
  margin: 0;
}

.net-status-details {
  border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  padding-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.net-detail-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.net-detail-label {
  color: var(--ios-label-secondary, #8E8E93);
}

.net-detail-value {
  font-weight: 600;
}

.net-fail-tips {
  background: rgba(255, 69, 58, 0.12);
  border-radius: 12rpx;
  padding: 12rpx;
}

.net-fail-tip {
  font-size: 20rpx;
  color: #FF453A;
  line-height: 1.4;
}

/* ================= 通道就绪框 (第 4 步) ================= */
.hotspot-ready-flow-box, .lan-direct-flow-box {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.lan-flow-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lan-flow-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.lan-step-pill {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.lan-flow-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.lan-flow-status {
  font-size: 20rpx;
}

.status-connected {
  color: #30D158;
}

.status-waiting {
  color: var(--ios-label-secondary, #8E8E93);
}

.hotspot-ready-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ready-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ready-chip {
  background: var(--ios-quaternary-bg, #3A3A3C);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.ready-explain-text {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  line-height: 1.45;
}

.ready-device-info-bar {
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  padding-top: 10rpx;
}

.lan-flow-desc {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  line-height: 1.4;
}

.wifi-action-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
}

.btn-wifi-test, .btn-wifi-connect {
  flex: 1;
  background: var(--ios-quaternary-bg, #3A3A3C);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 18rpx;
  height: 80rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  margin: 0;
  border: none;
}

.btn-active-wifi {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
}

/* ================= 4. 手机热点实时流量遥测 (Apple Battery/Screen Time Style) ================= */
.traffic-panel {
  background: var(--ios-secondary-bg, #1C1C1E);
}

.traffic-status-badge {
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.status-cutoff {
  background: rgba(255, 69, 58, 0.15);
  color: #FF453A;
  border: 0.5px solid rgba(255, 69, 58, 0.4);
}

.status-warn {
  background: rgba(255, 159, 10, 0.15);
  color: #FF9F0A;
  border: 0.5px solid rgba(255, 159, 10, 0.4);
}

.status-normal {
  background: rgba(48, 209, 88, 0.15);
  color: #30D158;
  border: 0.5px solid rgba(48, 209, 88, 0.4);
}

.traffic-gauge-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gauge-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
}

.gauge-label {
  color: var(--ios-label-secondary, #8E8E93);
}

.gauge-percent {
  font-weight: 700;
}

.text-amber { color: #FF9F0A; }

.gauge-bar-bg {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.gauge-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.35s ease;
}

.bar-red { background: #FF453A; }
.bar-amber { background: #FF9F0A; }
.bar-cyan { background: #64D2FF; }

.traffic-metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.metric-card {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.metric-card .metric-label {
  font-size: 18rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.metric-card .metric-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.metric-unit {
  font-size: 16rpx;
  color: var(--ios-label-tertiary, #636366);
  font-weight: 400;
}

.cutoff-notice-box {
  background: rgba(255, 69, 58, 0.12);
  border: 0.5px solid rgba(255, 69, 58, 0.35);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.notice-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.notice-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF453A;
}

.notice-sub {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1.4;
}

.traffic-actions-row {
  display: flex;
  gap: 12rpx;
}

.btn-traffic-action {
  flex: 1;
  background: var(--ios-tertiary-bg, #2C2C2E);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 16rpx;
  height: 68rpx;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  width: auto !important;
  margin: 0;
}

.btn-add-quota {
  background: var(--ios-blue, #0A84FF);
  border: none;
}

.btn-reset {
  color: #FF453A;
}

/* ================= 5. 系统偏好设置 (Apple Settings Grouped Rows) ================= */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  padding-right: 16rpx;
}

.setting-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.setting-desc {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.btn-ctrl-sub {
  background: var(--ios-tertiary-bg, #2C2C2E);
  color: var(--ios-blue, #0A84FF);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid rgba(10, 132, 255, 0.35);
  width: auto !important;
  margin: 0;
  flex-shrink: 0;
}

.btn-danger-sub {
  background: rgba(255, 69, 58, 0.15);
  color: #FF453A;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid rgba(255, 69, 58, 0.35);
  width: auto !important;
  margin: 0;
  flex-shrink: 0;
}

/* ================= 6. 固件契约与版本诊断 (Apple Inset Subcard) ================= */
.info-card {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
}

.info-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.info-lbl {
  color: var(--ios-label-secondary, #8E8E93);
  width: 140rpx;
  flex-shrink: 0;
}

.info-val {
  color: #FFFFFF;
  word-break: break-all;
}

/* ================= 7. 阿里云百炼大模型交互与离线唤醒词 Apple HIG 组件样式 ================= */
.bailian-panel {
  border-left: 6rpx solid #F59E0B;
}

.wakeword-panel {
  border-left: 6rpx solid #10B981;
}

.maintenance-panel {
  border-left: 6rpx solid #EF4444;
}

.picker-display-box {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.picker-current-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  font-size: 18rpx;
  color: var(--ios-label-secondary, #8E8E93);
  margin-left: 12rpx;
}

.voice-picker-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 8rpx;
}

.voice-picker {
  flex: 1;
}

.btn-voice-preview {
  background: rgba(245, 158, 11, 0.18);
  border: 0.5px solid rgba(245, 158, 11, 0.5);
  color: #FBBF24;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 16rpx;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  margin: 0;
  flex-shrink: 0;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.btn-voice-playing {
  background: rgba(10, 132, 255, 0.28) !important;
  border-color: rgba(10, 132, 255, 0.8) !important;
  color: #38BDF8 !important;
  animation: pulse-voice 1.2s infinite ease-in-out;
}

@keyframes pulse-voice {
  0% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.03); opacity: 1; box-shadow: 0 0 16rpx rgba(10, 132, 255, 0.4); }
  100% { transform: scale(1); opacity: 0.9; }
}

.prompt-hint {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.form-textarea {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1.45;
  height: 130rpx;
  margin-top: 8rpx;
}

.prompt-presets-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.preset-label {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
}

.preset-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.preset-tag {
  background: rgba(255, 255, 255, 0.07);
  border: 0.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: #E2E8F0;
  transition: all 0.15s ease;
}

.preset-tag:active {
  background: rgba(10, 132, 255, 0.25);
  border-color: #0A84FF;
  color: #64D2FF;
}

.btn-save-bailian {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 20rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.35);
}

.slider-row {
  margin-top: 14rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  padding: 16rpx;
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.slider-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.slider-val {
  font-size: 24rpx;
  font-weight: 700;
}

.slider-desc {
  font-size: 18rpx;
  color: var(--ios-label-secondary, #8E8E93);
  line-height: 1.4;
  display: block;
  margin-top: 6rpx;
}

.wakeword-actions-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.btn-save-wakeword {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 18rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.3);
}

.btn-test-wake {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(16, 185, 129, 0.5);
  color: #34D399;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 18rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.btn-warn-sub {
  background: rgba(245, 158, 11, 0.15);
  color: #FBBF24;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid rgba(245, 158, 11, 0.35);
  width: auto !important;
  margin: 0;
  flex-shrink: 0;
}

.physical-reset-hint {
  margin-top: 16rpx;
  background: rgba(239, 68, 68, 0.08);
  border: 0.5px solid rgba(239, 68, 68, 0.25);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
}

.hint-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #F87171;
  display: block;
  margin-bottom: 4rpx;
}

.hint-body {
  font-size: 19rpx;
  color: #CBD5E1;
  line-height: 1.45;
  display: block;
}
