/* pages/settings/settings.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 50rpx;
}

/* 顶部状态卡片 */
.status-card {
  background: #121929;
  border: 1px solid rgba(0, 242, 254, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.status-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.badge-online {
  background: rgba(0, 230, 118, 0.15);
  border: 1px solid #00e676;
  color: #00e676;
}

.badge-offline {
  background: rgba(148, 163, 184, 0.15);
  border: 1px solid #64748b;
  color: #94a3b8;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
}

.device-tag {
  font-size: 20rpx;
  color: #64748b;
}

.status-details {
  display: flex;
  justify-content: space-around;
  border-top: 1px solid #1e293b;
  padding-top: 16rpx;
}

.detail-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.detail-label {
  font-size: 20rpx;
  color: #64748b;
}

.detail-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #cbd5e1;
}

.highlight-pink {
  color: #f472b6;
}

/* 通用面板卡片 */
.panel-card {
  background: #121929;
  border: 1px solid #1e293b;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 1px solid #1e293b;
  padding-bottom: 12rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #00f2fe;
}

.panel-subtitle {
  font-size: 20rpx;
  color: #64748b;
}

/* BLE 扫描 */
.ble-action-row {
  display: flex;
  gap: 14rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 14rpx;
  border: none;
  padding: 16rpx 0;
  line-height: normal;
}

.btn-scanning {
  opacity: 0.8;
}

.btn-outline {
  background: #1e293b;
  border: 1px solid #475569;
  color: #f87171;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 16rpx 28rpx;
  line-height: normal;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #f8fafc;
}

.device-id {
  font-size: 18rpx;
  color: #64748b;
}

.device-rssi {
  font-size: 18rpx;
  color: #38bdf8;
}

.btn-connect-item {
  background: #0284c7;
  color: white;
  font-size: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  line-height: normal;
  border: none;
  margin: 0;
}

/* 表单输入组件 */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.input-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.form-input {
  background: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #f8fafc;
}

.input-with-action {
  display: flex;
  gap: 12rpx;
}

.input-with-action .form-input {
  flex: 1;
}

.btn-get-wifi {
  background: #1e293b;
  border: 1px solid #475569;
  color: #38bdf8;
  font-size: 20rpx;
  border-radius: 14rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  margin: 0;
}

.form-tip {
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.btn-provision {
  background: linear-gradient(135deg, #ec4899, #d946ef);
  color: white;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  padding: 18rpx 0;
  line-height: normal;
}

/* Wi-Fi 动作格 */
.wifi-action-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.btn-wifi-test, .btn-wifi-connect {
  flex: 1;
  background: #1e293b;
  border: 1px solid #334155;
  color: #cbd5e1;
  font-size: 22rpx;
  border-radius: 14rpx;
  padding: 16rpx 0;
  line-height: normal;
}

.btn-active-wifi {
  background: linear-gradient(135deg, #0284c7, #2563eb);
  color: white;
  border: none;
}

/* 系统偏好行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1px solid #1a2234;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  padding-right: 16rpx;
}

.setting-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #f8fafc;
}

.setting-desc {
  font-size: 20rpx;
  color: #64748b;
}

.btn-ctrl-sub {
  background: #1e293b;
  color: #38bdf8;
  font-size: 20rpx;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  border: 1px solid rgba(56, 189, 248, 0.4);
  line-height: normal;
  margin: 0;
}

.btn-danger-sub {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  font-size: 20rpx;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  border: 1px solid rgba(239, 68, 68, 0.4);
  line-height: normal;
  margin: 0;
}

/* 诊断信息卡片 */
.info-card {
  background: #090e1a;
  border: 1px solid #1e293b;
  font-size: 20rpx;
}

.info-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.info-lbl {
  color: #64748b;
  width: 140rpx;
  flex-shrink: 0;
}

.info-val {
  color: #94a3b8;
  word-break: break-all;
}
