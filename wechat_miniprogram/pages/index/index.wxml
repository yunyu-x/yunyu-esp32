<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部状态栏与硬件握手标识 (Apple HIG 状态胶囊) -->
  <view class="header-card">
    <view class="header-left">
      <view class="app-icon-wrap">
        <text class="app-icon">🐾</text>
      </view>
      <view class="app-title-group">
        <text class="app-title">悄悄 · 灵宠伴侣</text>
        <text class="app-subtitle">M5StickS3 · 掌心有爱随身相伴</text>
      </view>
    </view>
    <view class="status-badge-group">
      <view class="hotspot-badge" wx:if="{{hotspot && hotspot.isHotspot}}" bindtap="navigateToSettings">
        <text>📱 {{hotspot.usedMb}}/{{hotspot.limitMb}}M</text>
      </view>
      <!-- BLE 蓝牙状态标志 -->
      <view class="status-badge {{isBleMode ? 'badge-ble-connected' : 'badge-ble-disconnected'}}" bindtap="navigateToSettings">
        <view class="status-dot"></view>
        <text>{{isBleMode ? '蓝牙已连' : '未连接'}}</text>
      </view>
      <!-- Wi-Fi / 热点网络状态标志 (统一硬件实际联网状态) -->
      <view class="status-badge {{isDeviceWifiOnline ? (networkBadgeClass || 'status-online') : 'status-offline-red'}}" bindtap="navigateToSettings">
        <view class="status-dot"></view>
        <text>{{networkBadgeText || (isDeviceWifiOnline ? '在线' : '离线')}}</text>
      </view>
    </view>
  </view>

  <!-- 设备断网离线醒目警示条 (仅在设备真正未连接网络且非仿真模式下展示) -->
  <view class="wifi-offline-banner" wx:if="{{!isDeviceWifiOnline && !isSimMode}}" bindtap="navigateToSettings">
    <text class="banner-icon">🛑</text>
    <text class="banner-text">M5StickS3 当前处于断网离线状态，大模型语音对话需网络支持。点击前往一键配网 ›</text>
  </view>

  <!-- 手机共享热点超额熔断与预警提示栏 -->
  <view class="hotspot-alert-banner" wx:if="{{hotspot && hotspot.cutoffActive}}" bindtap="navigateToSettings">
    <text class="banner-icon">🛑</text>
    <text class="banner-text">手机热点已达 {{hotspot.limitMb}}MB 上限，语音流已自动熔断保护。点击前往调整配额 ›</text>
  </view>
  <view class="hotspot-warn-banner" wx:elif="{{hotspot && hotspot.isHotspot && hotspot.usedMb >= hotspot.limitMb * 0.8}}" bindtap="navigateToSettings">
    <text class="banner-icon">⚠️</text>
    <text class="banner-text">热点流量已使用 {{hotspot.usedMb}}MB (超80%)，请留意流量消耗。点击管理 ›</text>
  </view>

  <!-- 灵宠主画板区 (采用高自适应 <avatar-canvas> 自定义组件) -->
  <view class="avatar-card">
    <view class="canvas-wrapper">
      <avatar-canvas 
        id="buddyAvatar"
        petState="{{petState}}" 
        widthRpx="270" 
        heightRpx="480"
        bind:avataction="handleAvatarTouchAction"
      ></avatar-canvas>
    </view>

    <!-- 侧边实时 HUD 遥测数值面板 -->
    <view class="hud-meta">
      <view class="pet-title-row">
        <text class="pet-name">{{petState.name}}</text>
        <text class="mood-pill">{{currentMoodTag}}</text>
      </view>

      <view class="meta-row">
        <text class="meta-label">⭐ 亲密羁绊</text>
        <text class="meta-val highlight-pink">Lv.{{petState.level}} ({{petState.xp}}/100 XP)</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill xp-fill" style="width: {{petState.xp}}%;"></view>
      </view>

      <view class="meta-row" style="margin-top: 14rpx;">
        <text class="meta-label">⚡ 活力与体力</text>
        <text class="meta-val highlight-cyan">{{petState.energy}}%</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill energy-fill" style="width: {{petState.energy}}%;"></view>
      </view>

      <!-- 交互统计标签 -->
      <view class="stat-tags">
        <view class="stat-tag">🍰 投喂: {{petState.feeds}}</view>
        <view class="stat-tag">✨ 梳毛: {{petState.grooms}}</view>
        <view class="stat-tag">🌸 抚摸: {{petState.pets}}</view>
        <view class="stat-tag">🌀 摇晃: {{petState.shakes}}</view>
      </view>

      <!-- 触碰操作提示 -->
      <view class="touch-guide-tip">
        <text>💡 轻触头部抚摸 / 嘴部投喂 / 长按击掌</text>
      </view>
    </view>
  </view>

  <!-- 极速快捷通道卡片 -->
  <view class="quick-room-nav">
    <view class="room-banner feed-banner" bindtap="navigateToFeed">
      <view class="room-info">
        <text class="room-title">🍰 灵宠甜点工坊</text>
        <text class="room-desc">草莓大福、舒芙蕾与热可可，为悄悄补充能量</text>
      </view>
      <text class="room-btn">去投喂 ›</text>
    </view>
  </view>

  <!-- 第一人称灵宠即时心声日记卡片 -->
  <view class="diary-card">
    <view class="diary-header">
      <text class="diary-title">📖 {{petState.name}} 的即时心声</text>
      <text class="diary-link" bindtap="navigateToDiary">全部日记 ({{diaryCount}}篇) ›</text>
    </view>
    <view class="diary-bubble" bindtap="navigateToDiary">
      “{{petState.diary}}”
    </view>
  </view>

  <!-- 历史对话记忆预览卡片 -->
  <view class="memory-card">
    <view class="memory-header">
      <view class="memory-title-group">
        <text class="memory-title">💬 {{petState.name}} 的最新对话</text>
        <text class="memory-badge" wx:if="{{memoryCount > 0}}">{{memoryCount}}轮</text>
      </view>
      <text class="memory-link" bindtap="navigateToDialogueHistory">历史记录 ›</text>
    </view>
    <view class="memory-preview-bubble" bindtap="navigateToDialogueHistory" wx:if="{{latestMemory}}">
      <view class="mem-preview-row">
        <text class="mem-role-tag user-tag">我:</text>
        <text class="mem-snippet-text">{{latestMemory.user}}</text>
      </view>
      <view class="mem-preview-row">
        <text class="mem-role-tag pet-tag">{{petState.name}}:</text>
        <text class="mem-snippet-text pet-answer">{{latestMemory.ai}}</text>
      </view>
    </view>
    <view class="memory-empty-preview" bindtap="navigateToDialogueHistory" wx:else>
      <text>暂无历史对话，呼唤“悄悄”唤醒词开启畅聊 ›</text>
    </view>
  </view>

  <!-- 拓麻歌子具身互动控制中心 (Apple Control Center 风格触控) -->
  <view class="tamagotchi-card">
    <view class="section-title">
      <text>💫 掌心具身互动</text>
      <text class="section-sub">支持真机触觉反馈与和弦同步</text>
    </view>

    <!-- 核心互动四网格 -->
    <view class="action-grid">
      <button class="btn-action btn-pet" bindtap="handlePetAction">
        <text class="action-icon">🌸</text>
        <text class="action-text">温柔抚摸</text>
      </button>
      <button class="btn-action btn-groom" bindtap="handleGroomAction">
        <text class="action-icon">✨</text>
        <text class="action-text">舒适梳毛</text>
      </button>
      <button class="btn-action btn-play" bindtap="handlePlayAction">
        <text class="action-icon">✋</text>
        <text class="action-text">默契击掌</text>
      </button>
      <button class="btn-action btn-shake" bindtap="handleShakeAction">
        <text class="action-icon">🌀</text>
        <text class="action-text">调皮转圈</text>
      </button>
    </view>

    <!-- 辅助控制 -->
    <view class="sub-action-grid">
      <button class="btn-sub" bindtap="handleSleepAction">🌙 伴侣晚安入睡</button>
      <button class="btn-sub" bindtap="handleWakeAction">☀️ 晨起轻唤醒</button>
      <button class="btn-sub" bindtap="handleToggleAvatarMode">🎨 切换屏显模式</button>
    </view>
  </view>

  <!-- 连接与信道快捷栏 -->
  <view class="connect-grid">
    <button class="btn-connect {{isBleMode ? 'btn-active' : ''}}" bindtap="handleToggleBle">
      <text>⚡</text> <text>{{bleBtnText}}</text>
    </button>
    <button class="btn-connect {{isWifiMode ? 'btn-active' : ''}}" bindtap="handleToggleWifi">
      <text>📶</text> <text>{{wifiBtnText}}</text>
    </button>
    <button class="btn-sim {{isSimMode ? 'btn-active-sim' : ''}}" bindtap="handleToggleSim">
      <text>🎮</text> <text>{{simBtnText}}</text>
    </button>
  </view>
</view>
