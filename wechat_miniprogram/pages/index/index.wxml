<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部状态栏与硬件握手标识 (Apple HIG 状态胶囊) -->
  <view class="header-card">
    <view class="header-left">
      <view class="app-icon-wrap">
        <text class="app-icon">🐾</text>
      </view>
      <view class="app-title-group">
        <text class="app-title">悄悄 · 灵宠伴侣</text>
        <text class="app-subtitle">M5StickS3 · 掌心有爱随身相伴</text>
      </view>
    </view>
    <view class="status-badge-group">
      <view class="hotspot-badge" wx:if="{{hotspot && hotspot.isHotspot}}" bindtap="navigateToSettings">
        <text>📱 {{hotspot.usedMb}}/{{hotspot.limitMb}}M</text>
      </view>
      <!-- BLE 蓝牙状态标志 -->
      <view class="status-badge {{isBleMode ? 'badge-ble-connected' : 'badge-ble-disconnected'}}" bindtap="navigateToSettings">
        <view class="status-dot"></view>
        <text>{{isBleMode ? '蓝牙已连' : '未连接'}}</text>
      </view>
      <!-- Wi-Fi / 热点网络状态标志 (统一硬件实际联网状态) -->
      <view class="status-badge {{isDeviceWifiOnline ? (networkBadgeClass || 'status-online') : 'status-offline-red'}}" bindtap="navigateToSettings">
        <view class="status-dot"></view>
        <text>{{networkBadgeText || (isDeviceWifiOnline ? '在线' : '离线')}}</text>
      </view>
    </view>
  </view>

  <!-- 设备断网离线醒目警示条 (仅在设备真正未连接网络且非仿真模式下展示) -->
  <view class="wifi-offline-banner" wx:if="{{!isDeviceWifiOnline && !isSimMode}}" bindtap="navigateToSettings">
    <text class="banner-icon">🛑</text>
    <text class="banner-text">M5StickS3 当前处于断网离线状态，大模型语音对话需网络支持。点击前往一键配网 ›</text>
  </view>

  <!-- 手机共享热点超额熔断与预警提示栏 -->
  <view class="hotspot-alert-banner" wx:if="{{hotspot && hotspot.cutoffActive}}" bindtap="navigateToSettings">
    <text class="banner-icon">🛑</text>
    <text class="banner-text">手机热点已达 {{hotspot.limitMb}}MB 上限，语音流已自动熔断保护。点击前往调整配额 ›</text>
  </view>
  <view class="hotspot-warn-banner" wx:elif="{{hotspot && hotspot.isHotspot && hotspot.usedMb >= hotspot.limitMb * 0.8}}" bindtap="navigateToSettings">
    <text class="banner-icon">⚠️</text>
    <text class="banner-text">热点流量已使用 {{hotspot.usedMb}}MB (超80%)，请留意流量消耗。点击管理 ›</text>
  </view>

  <!-- 灵宠主画板区 (自适应 <avatar-canvas> 或 功夫阿韧微雕动画像素舱) -->
  <view class="avatar-card">
    <view class="canvas-wrapper">
      <block wx:if="{{activePet === 'jollybot'}}">
        <view class="cadet-preview-wrapper" bindtap="handleCadetAvatarTap">
          <image class="cadet-preview-image" src="{{cadetPreviewUrl}}" mode="aspectFit" />
          <view class="cadet-live-badge">
            <text class="cadet-live-dot"></text>
            <text>{{isTransitionPlaying ? '⚡ 动作过渡中' : (cadetRenderMode === 'fullcolor' ? '🎨 全色域' : '✍️ 线稿微雕')}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <avatar-canvas 
          id="buddyAvatar"
          petState="{{petState}}" 
          widthRpx="270" 
          heightRpx="480"
          bind:avataction="handleAvatarTouchAction"
        ></avatar-canvas>
      </block>
    </view>

    <!-- 侧边实时 HUD 遥测数值面板 -->
    <view class="hud-meta">
      <view class="pet-title-row">
        <text class="pet-name">{{petState.name}}</text>
        <view class="pet-switch-pill" bindtap="handleTogglePetType">
          <text class="pill-switch-icon">🔄</text>
          <text class="pill-switch-text">{{activePet === 'jollybot' ? '切悄悄' : '切阿韧'}}</text>
        </view>
        <text class="mood-pill">{{currentMoodTag}}</text>
      </view>

      <view class="meta-row">
        <text class="meta-label">⭐ 亲密羁绊</text>
        <text class="meta-val highlight-pink">Lv.{{petState.level}} ({{petState.xp}}/100 XP)</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill xp-fill" style="width: {{petState.xp}}%;"></view>
      </view>

      <view class="meta-row" style="margin-top: 14rpx;">
        <text class="meta-label">⚡ 活力与体力</text>
        <text class="meta-val highlight-cyan">{{petState.energy}}%</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fill energy-fill" style="width: {{petState.energy}}%;"></view>
      </view>

      <!-- 交互统计标签 -->
      <view class="stat-tags">
        <view class="stat-tag">🍰 投喂: {{petState.feeds}}</view>
        <view class="stat-tag">✨ 梳毛: {{petState.grooms}}</view>
        <view class="stat-tag">🌸 抚摸: {{petState.pets}}</view>
        <view class="stat-tag">🌀 摇晃: {{petState.shakes}}</view>
      </view>

      <!-- 触碰操作提示 -->
      <view class="touch-guide-tip">
        <text>💡 轻触头部抚摸 / 嘴部投喂 / 长按击掌</text>
      </view>
    </view>
  </view>

  <!-- 极速快捷通道卡片 -->
  <view class="quick-room-nav">
    <view class="room-banner feed-banner" bindtap="navigateToFeed">
      <view class="room-info">
        <text class="room-title">🍰 灵宠甜点工坊</text>
        <text class="room-desc">草莓大福、舒芙蕾与热可可，为悄悄补充能量</text>
      </view>
      <text class="room-btn">去投喂 ›</text>
    </view>
  </view>

  <!-- 第一人称灵宠即时心声日记卡片 -->
  <view class="diary-card">
    <view class="diary-header">
      <text class="diary-title">📖 {{petState.name}} 的即时心声</text>
      <text class="diary-link" bindtap="navigateToDiary">全部日记 ({{diaryCount}}篇) ›</text>
    </view>
    <view class="diary-bubble" bindtap="navigateToDiary">
      “{{petState.diary}}”
    </view>
  </view>

  <!-- 历史对话记忆预览卡片 -->
  <view class="memory-card">
    <view class="memory-header">
      <view class="memory-title-group">
        <text class="memory-title">💬 {{petState.name}} 的最新对话</text>
        <text class="memory-badge" wx:if="{{memoryCount > 0}}">{{memoryCount}}轮</text>
      </view>
      <text class="memory-link" bindtap="navigateToDialogueHistory">历史记录 ›</text>
    </view>
    <view class="memory-preview-bubble" bindtap="navigateToDialogueHistory" wx:if="{{latestMemory}}">
      <view class="mem-preview-row">
        <text class="mem-role-tag user-tag">我:</text>
        <text class="mem-snippet-text">{{latestMemory.user}}</text>
      </view>
      <view class="mem-preview-row">
        <text class="mem-role-tag pet-tag">{{petState.name}}:</text>
        <text class="mem-snippet-text pet-answer">{{latestMemory.ai}}</text>
      </view>
    </view>
    <view class="memory-empty-preview" bindtap="navigateToDialogueHistory" wx:else>
      <text>暂无历史对话，呼唤“悄悄”唤醒词开启畅聊 ›</text>
    </view>
  </view>

  <!-- 拓麻歌子具身互动控制中心 (Apple Control Center 风格触控) -->
  <view class="tamagotchi-card">
    <view class="section-title">
      <text>💫 掌心具身互动</text>
      <text class="section-sub">支持真机触觉反馈与和弦同步</text>
    </view>

    <!-- 核心互动四网格 -->
    <view class="action-grid">
      <button class="btn-action btn-pet" bindtap="handlePetAction">
        <text class="action-icon">🌸</text>
        <text class="action-text">温柔抚摸</text>
      </button>
      <button class="btn-action btn-groom" bindtap="handleGroomAction">
        <text class="action-icon">✨</text>
        <text class="action-text">舒适梳毛</text>
      </button>
      <button class="btn-action btn-play" bindtap="handlePlayAction">
        <text class="action-icon">✋</text>
        <text class="action-text">默契击掌</text>
      </button>
      <button class="btn-action btn-shake" bindtap="handleShakeAction">
        <text class="action-icon">🌀</text>
        <text class="action-text">调皮转圈</text>
      </button>
    </view>

    <!-- 辅助控制 -->
    <view class="sub-action-grid">
      <button class="btn-sub" bindtap="handleSleepAction">🌙 伴侣晚安入睡</button>
      <button class="btn-sub" bindtap="handleWakeAction">☀️ 晨起轻唤醒</button>
      <button class="btn-sub" bindtap="handleToggleAvatarMode">🎨 切换屏显模式</button>
    </view>
  </view>

  <!-- 迪士尼影院级动作姿态点播与阅兵大厅 (17-Action Cinematic Director) -->
  <view class="cinematic-card">
    <view class="cinematic-header">
      <view class="cinematic-title-group">
        <text class="cinematic-title">🎬 迪士尼影院级动作姿态</text>
        <text class="cinematic-sub">17 套生物力学招式 · 严格体积守恒 · S曲线平滑过渡</text>
      </view>
      <view class="cinematic-badge {{isDemoShowcaseActive ? 'demo-active-badge' : ''}}">
        {{isDemoShowcaseActive ? '🎪 阅兵进行中' : '✨ 自由点播'}}
      </view>
    </view>

    <!-- 阅兵与单步快捷控制栏 -->
    <view class="cinematic-ctl-bar">
      <button class="btn-cine-ctl btn-demo {{isDemoShowcaseActive ? 'btn-demo-on' : ''}}" bindtap="handleToggleDemoShowcase">
        <text class="cine-btn-icon">{{isDemoShowcaseActive ? '⏹' : '🎬'}}</text>
        <text>{{isDemoShowcaseActive ? '停止全套阅兵' : '全套动作自动阅兵'}}</text>
      </button>
      <button class="btn-cine-ctl btn-step" bindtap="handleNextPose">
        <text class="cine-btn-icon">⏭</text>
        <text>切换下一个姿态</text>
      </button>
    </view>

    <!-- 动作卡片横向滚动矩阵展示 -->
    <scroll-view class="actions-scroll-view" scroll-x="true" enable-flex="true">
      <view class="action-chips-wrapper">
        <block wx:for="{{cinematicActions}}" wx:key="act">
          <view 
            class="action-chip {{currentActionAct === item.act ? 'chip-active' : ''}} {{petState.level < item.minLvl ? 'chip-locked' : ''}}"
            bindtap="handleSelectBearAction"
            data-act="{{item.act}}"
            data-minlvl="{{item.minLvl}}"
          >
            <view class="chip-top">
              <text class="chip-icon">{{item.icon}}</text>
              <text class="chip-lvl" wx:if="{{petState.level < item.minLvl}}">🔒 Lv.{{item.minLvl}}</text>
              <text class="chip-lvl lvl-unlocked" wx:else>Lv.{{item.minLvl}}</text>
            </view>
            <text class="chip-name">{{item.name}}</text>
            <text class="chip-desc">{{item.desc}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 功夫学徒阿韧动作导播与全色域渲染控制舱 (Cadet Ren Martial Director) -->
  <view class="cadet-director-card">
    <view class="cadet-director-header">
      <view class="cadet-title-group">
        <text class="cadet-title">🥋 功夫学徒阿韧 · 动作导播台</text>
        <text class="cadet-sub">Phase 2 全色域微雕分层渲染 · 7 大绝招即时点播</text>
      </view>
      <!-- 双模式即时切换 Pill 胶囊按钮 -->
      <view class="cadet-mode-pill" bindtap="handleToggleCadetMode">
        <text class="pill-dot {{cadetRenderMode === 'fullcolor' ? 'dot-color' : 'dot-line'}}"></text>
        <text class="pill-text">{{cadetRenderMode === 'fullcolor' ? '🎨 全色域彩绘' : '✍️ 象牙金微雕'}}</text>
      </view>
    </view>

    <!-- 宗师连招与套路一键宏快捷栏 -->
    <view class="cadet-macro-bar">
      <button class="btn-cadet-macro" bindtap="handleTriggerCadetCombo">
        <text class="macro-icon">⚡</text>
        <text class="macro-text">一键发动【宗师连携套路】(抱拳·马步·太极·咏春·升龙)</text>
      </button>
    </view>

    <!-- 7 大绝招横向滑动漫游卡片 -->
    <scroll-view class="cadet-scroll-view" scroll-x="true" enable-flex="true">
      <view class="cadet-stunts-wrapper">
        <block wx:for="{{cadetStunts}}" wx:key="act">
          <view 
            class="cadet-stunt-card {{currentCadetStunt === item.act ? 'stunt-active' : ''}} {{petState.level < item.minLvl ? 'stunt-locked' : ''}}"
            bindtap="handleTriggerCadetStunt"
            data-act="{{item.act}}"
            data-minlvl="{{item.minLvl}}"
          >
            <view class="stunt-header">
              <text class="stunt-icon">{{item.icon}}</text>
              <text class="stunt-lvl {{petState.level >= item.minLvl ? 'stunt-lvl-on' : ''}}">
                {{petState.level < item.minLvl ? '🔒 Lv.' + item.minLvl : 'Lv.' + item.minLvl}}
              </text>
            </view>
            <text class="stunt-name">{{item.name}}</text>
            <text class="stunt-en">{{item.en}}</text>
            <text class="stunt-desc">{{item.desc}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 3D 姿态与人形关节动力学控制舱 (Apple HIG 拟物卡片) -->
  <view class="posture-card">
    <view class="section-title">
      <text>🧸 3D 姿态与人形关节动力学</text>
      <text class="section-sub">支持 3D 空间偏航、180°转身露尾巴、360°自旋与 23 点关节微调</text>
    </view>

    <!-- 1. 3D 偏航旋转与特技 -->
    <view class="posture-section">
      <view class="posture-row-title">
        <text class="posture-label">🔄 3D 偏航旋转 (Yaw: {{bearYaw}}°)</text>
      </view>
      <slider 
        min="0" 
        max="360" 
        value="{{bearYaw}}" 
        step="5" 
        activeColor="#FF7A8A" 
        backgroundColor="#2A2A38" 
        block-size="20" 
        block-color="#FFFFFF" 
        show-value 
        bindchange="handleYawChange"
        bindchanging="handleYawChange"
      />
      <view class="posture-stunt-btns">
        <button class="btn-stunt" bindtap="handleTurn180">
          <text>🔄 180° 转身看背影</text>
        </button>
        <button class="btn-stunt" bindtap="handleSpin360">
          <text>🩰 360° 芭蕾自旋</text>
        </button>
      </view>
    </view>

    <!-- 2. BMI270 物理重力姿态自平衡 -->
    <view class="posture-section balance-section">
      <view class="balance-header">
        <view class="balance-title-group">
          <text class="balance-title">⚖️ BMI270 物理重力自平衡</text>
          <text class="balance-desc">倾斜或摇晃物理设备，小熊实时展臂屈膝对抗重力</text>
        </view>
        <switch 
          checked="{{imuBalanceEnabled}}" 
          color="#10B981" 
          bindchange="handleToggleImuBalance"
        />
      </view>
    </view>

    <!-- 3. OpenPose 人形关节精细调谐器 -->
    <view class="posture-section joint-section">
      <view class="posture-row-title">
        <text class="posture-label">🦾 OpenPose 独立关节微调</text>
        <button class="btn-joint-reset" bindtap="handleClearJoints">复位姿态</button>
      </view>
      <picker range="{{jointNames}}" value="{{selectedJointIndex}}" bindchange="handleJointSelect">
        <view class="joint-picker-box">
          <text class="picker-label">目标关节:</text>
          <text class="picker-value">{{jointNames[selectedJointIndex]}} ▾</text>
        </view>
      </picker>
      <view class="joint-slider-wrap">
        <view class="posture-row-title">
          <text class="sub-label">偏转角度 ({{selectedJointAngle > 0 ? '+' : ''}}{{selectedJointAngle}}°):</text>
        </view>
        <slider 
          min="-90" 
          max="90" 
          value="{{selectedJointAngle}}" 
          step="5" 
          activeColor="#00E5FF" 
          backgroundColor="#2A2A38" 
          block-size="18" 
          block-color="#FFFFFF" 
          show-value 
          bindchange="handleJointAngleChange"
        />
      </view>
    </view>
  </view>

  <!-- 灵宠与灵方多体编队舞团控制台 -->
  <view class="swarm-dance-card">
    <view class="swarm-dance-header">
      <view class="swarm-title-row">
        <text class="swarm-title">🎭 灵宠与灵方舞团编队</text>
        <text class="swarm-status-tag {{isSwarmDancing ? 'dancing-active' : ''}}">
          {{isSwarmDancing ? '💃 编队巡演中' : '🎵 就绪'}}
        </text>
      </view>
      <text class="swarm-sub">屏内小熊 3D 起舞，桌上灵方微型机器人翻滚对偶</text>
    </view>
    <view class="swarm-dance-grid">
      <button class="swarm-dance-btn btn-waltz" bindtap="handleTriggerSwarmDance" data-theme="waltz">
        <text class="swarm-btn-icon">💃</text>
        <view class="swarm-btn-text">
          <text class="swarm-btn-name">元气华尔兹</text>
          <text class="swarm-btn-meta">120 BPM · 摇摆自旋</text>
        </view>
      </button>
      <button class="swarm-dance-btn btn-zen" bindtap="handleTriggerSwarmDance" data-theme="zen">
        <text class="swarm-btn-icon">🥋</text>
        <view class="swarm-btn-text">
          <text class="swarm-btn-name">太极云手阵</text>
          <text class="swarm-btn-meta">80 BPM · 行云流水</text>
        </view>
      </button>
      <button class="swarm-dance-btn btn-moonwalk" bindtap="handleTriggerSwarmDance" data-theme="moonwalk">
        <text class="swarm-btn-icon">👟</text>
        <view class="swarm-btn-text">
          <text class="swarm-btn-name">太空漫步秀</text>
          <text class="swarm-btn-meta">130 BPM · 滑步冲拳</text>
        </view>
      </button>
      <button class="swarm-dance-btn btn-cyber" bindtap="handleTriggerSwarmDance" data-theme="cyber">
        <text class="swarm-btn-icon">⚡</text>
        <view class="swarm-btn-text">
          <text class="swarm-btn-name">机甲破晓舞</text>
          <text class="swarm-btn-meta">140 BPM · 升龙飞天</text>
        </view>
      </button>
    </view>
    <button class="btn-ceremony-trigger" bindtap="handleTriggerCeremony">
      <text>★ 触发技能解锁盛典特效</text>
    </button>
  </view>

  <!-- 连接与信道快捷栏 -->
  <view class="connect-grid">
    <button class="btn-connect {{isBleMode ? 'btn-active' : ''}}" bindtap="handleToggleBle">
      <text>⚡</text> <text>{{bleBtnText}}</text>
    </button>
    <button class="btn-connect {{isWifiMode ? 'btn-active' : ''}}" bindtap="handleToggleWifi">
      <text>📶</text> <text>{{wifiBtnText}}</text>
    </button>
    <button class="btn-sim {{isSimMode ? 'btn-active-sim' : ''}}" bindtap="handleToggleSim">
      <text>🎮</text> <text>{{simBtnText}}</text>
    </button>
  </view>
</view>
