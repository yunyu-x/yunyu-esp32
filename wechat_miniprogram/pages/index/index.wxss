/* pages/index/index.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

/* 顶部状态栏 */
.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #121929;
  border: 1px solid rgba(0, 242, 254, 0.18);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.app-icon {
  font-size: 44rpx;
}

.app-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #00f2fe;
  display: block;
}

.app-subtitle {
  font-size: 20rpx;
  color: #8a99ad;
  display: block;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
  cursor: pointer;
}

.status-online {
  background: rgba(0, 230, 118, 0.15);
  border: 1px solid #00e676;
  color: #00e676;
}

.badge-hotspot-connected {
  background: rgba(245, 158, 11, 0.15);
  border: 1px solid #f59e0b;
  color: #fbbf24;
}

.status-offline {
  background: rgba(148, 163, 184, 0.15);
  border: 1px solid #64748b;
  color: #94a3b8;
}

.badge-ble-connected {
  background: rgba(0, 242, 254, 0.15);
  border: 1px solid #00f2fe;
  color: #00f2fe;
  box-shadow: 0 0 10rpx rgba(0, 242, 254, 0.25);
}

.badge-ble-disconnected {
  background: rgba(148, 163, 184, 0.15);
  border: 1px solid #64748b;
  color: #94a3b8;
}

.status-offline-red {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid #ef4444;
  color: #f87171;
  animation: pulse-offline-border 2s infinite ease-in-out;
}

@keyframes pulse-offline-border {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
  }
  50% {
    box-shadow: 0 0 12rpx 2rpx rgba(239, 68, 68, 0.6);
  }
}

.wifi-offline-banner {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.5);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  animation: pulse-offline-banner 2.5s infinite;
}

@keyframes pulse-offline-banner {
  0%, 100% {
    opacity: 0.95;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.3);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 14rpx rgba(239, 68, 68, 0.5);
  }
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-arrow {
  font-size: 20rpx;
  opacity: 0.8;
  margin-left: 4rpx;
}

.status-badge-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hotspot-badge {
  background: rgba(236, 72, 153, 0.2);
  border: 1px solid #ec4899;
  color: #f472b6;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
}

/* 热点熔断与告警横幅 */
.hotspot-alert-banner {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid #ef4444;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  animation: pulse-alert 2s infinite;
}

.hotspot-warn-banner {
  background: rgba(245, 158, 11, 0.2);
  border: 1px solid #f59e0b;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

@keyframes pulse-alert {
  0% { opacity: 0.9; }
  50% { opacity: 1; box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.4); }
  100% { opacity: 0.9; }
}

.banner-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.banner-text {
  font-size: 20rpx;
  color: #f8fafc;
  line-height: 1.4;
  flex: 1;
}

/* 灵宠主画板区 */
.avatar-card {
  display: flex;
  flex-direction: row;
  background: #121929;
  border: 1px solid rgba(255, 117, 140, 0.25);
  border-radius: 24rpx;
  padding: 20rpx;
  gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.canvas-wrapper {
  width: 270rpx;
  height: 480rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #000;
  flex-shrink: 0;
}

.hud-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pet-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #f8fafc;
}

.mood-pill {
  font-size: 20rpx;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.35);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.meta-label {
  color: #94a3b8;
}

.highlight-pink {
  color: #f472b6;
  font-weight: 700;
}

.highlight-cyan {
  color: #38bdf8;
  font-weight: 700;
}

.bar-bg {
  width: 100%;
  height: 14rpx;
  background: #020617;
  border-radius: 999rpx;
  overflow: hidden;
  border: 1px solid #1e293b;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.xp-fill {
  background: linear-gradient(90deg, #ec4899, #f43f5e);
}

.energy-fill {
  background: linear-gradient(90deg, #06b6d4, #3b82f6);
}

.stat-tags {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.stat-tag {
  background: #0f172a;
  border: 1px solid #1e293b;
  border-radius: 12rpx;
  padding: 8rpx 10rpx;
  font-size: 20rpx;
  color: #cbd5e1;
  text-align: center;
}

.touch-guide-tip {
  margin-top: 12rpx;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 10rpx;
  padding: 8rpx 10rpx;
  font-size: 18rpx;
  color: #64748b;
  text-align: center;
}

/* 投喂屋快捷横幅 */
.quick-room-nav {
  width: 100%;
}

.feed-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(217, 70, 239, 0.15));
  border: 1px solid rgba(236, 72, 153, 0.35);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  cursor: pointer;
}

.room-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f472b6;
  display: block;
}

.room-desc {
  font-size: 20rpx;
  color: #cbd5e1;
  display: block;
  margin-top: 4rpx;
}

.room-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #f472b6;
  background: rgba(236, 72, 153, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 心声日记 */
.diary-card, .tamagotchi-card {
  background: #121929;
  border: 1px solid #1e293b;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.diary-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f6d365;
}

.diary-link {
  font-size: 20rpx;
  color: #38bdf8;
  cursor: pointer;
}

.diary-bubble {
  background: #020617;
  border: 1px solid #334155;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #e2e8f0;
  line-height: 1.6;
  cursor: pointer;
}

/* 历史对话记忆预览 */
.memory-card {
  background: #121929;
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.memory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.memory-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.memory-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #38bdf8;
}

.memory-badge {
  font-size: 18rpx;
  background: rgba(56, 189, 248, 0.15);
  border: 1px solid #38bdf8;
  color: #38bdf8;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
}

.memory-link {
  font-size: 20rpx;
  color: #38bdf8;
  cursor: pointer;
}

.memory-preview-bubble {
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  cursor: pointer;
}

.mem-preview-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.mem-role-tag {
  font-weight: 700;
  flex-shrink: 0;
}

.user-tag {
  color: #94a3b8;
}

.pet-tag {
  color: #00f2fe;
}

.mem-snippet-text {
  color: #cbd5e1;
  word-break: break-all;
}

.pet-answer {
  color: #f1f5f9;
}

.memory-empty-preview {
  background: #020617;
  border: 1px dashed #334155;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  cursor: pointer;
}

/* 拓麻歌子互动区 */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  font-weight: 700;
  color: #00f2fe;
  margin-bottom: 16rpx;
}

.section-sub {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 400;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.btn-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: white;
  border: none;
  width: 100% !important;
  margin: 0;
}

.btn-action:active {
  transform: scale(0.98);
}

.btn-pet   { background: linear-gradient(135deg, #10b981, #059669); }
.btn-groom { background: linear-gradient(135deg, #06b6d4, #0ea5e9); }
.btn-play  { background: linear-gradient(135deg, #f59e0b, #eab308); }
.btn-shake { background: linear-gradient(135deg, #6366f1, #4f46e5); }

.sub-action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10rpx;
}

.btn-sub {
  background: #1e293b;
  border: 1px solid #334155;
  color: #cbd5e1;
  font-size: 20rpx;
  border-radius: 14rpx;
  height: 68rpx;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 0;
}

/* 连接快捷栏 */
.connect-grid {
  display: flex;
  gap: 12rpx;
}

.btn-connect, .btn-sim {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  min-height: 76rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  color: #fff;
  background: #1e293b;
  width: auto !important;
  margin: 0;
}

.btn-active {
  background: linear-gradient(135deg, #0284c7, #2563eb);
}

.btn-active-sim {
  background: linear-gradient(135deg, #7c3aed, #9333ea);
}
