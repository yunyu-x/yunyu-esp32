/* pages/index/index.wxss - Apple HIG Dark Mode Aesthetic */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 50rpx;
  background-color: var(--ios-bg, #000000);
}

/* ================= 顶部状态栏与硬件握手标识 ================= */
.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.app-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 55, 95, 0.2), rgba(255, 159, 10, 0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.5px solid rgba(255, 255, 255, 0.1);
}

.app-icon {
  font-size: 32rpx;
}

.app-title-group {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.app-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.3rpx;
}

.app-subtitle {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  letter-spacing: -0.2rpx;
}

.status-badge-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.status-online {
  background: rgba(48, 209, 88, 0.15);
  border: 0.5px solid rgba(48, 209, 88, 0.4);
  color: #30D158;
}

.badge-hotspot-connected {
  background: rgba(255, 159, 10, 0.15);
  border: 0.5px solid rgba(255, 159, 10, 0.4);
  color: #FF9F0A;
}

.status-offline {
  background: rgba(142, 142, 147, 0.15);
  border: 0.5px solid rgba(142, 142, 147, 0.3);
  color: #8E8E93;
}

.badge-ble-connected {
  background: rgba(10, 132, 255, 0.15);
  border: 0.5px solid rgba(10, 132, 255, 0.4);
  color: #0A84FF;
}

.badge-ble-disconnected {
  background: rgba(142, 142, 147, 0.12);
  border: 0.5px solid rgba(142, 142, 147, 0.25);
  color: #8E8E93;
}

.status-offline-red {
  background: rgba(255, 69, 58, 0.15);
  border: 0.5px solid rgba(255, 69, 58, 0.5);
  color: #FF453A;
}

.hotspot-badge {
  background: rgba(255, 55, 95, 0.15);
  border: 0.5px solid rgba(255, 55, 95, 0.4);
  color: #FF375F;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

/* ================= 提示与告警横幅 (Apple HIG Alert Pill) ================= */
.wifi-offline-banner {
  background: rgba(255, 69, 58, 0.12);
  border: 0.5px solid rgba(255, 69, 58, 0.35);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hotspot-alert-banner {
  background: rgba(255, 69, 58, 0.15);
  border: 0.5px solid rgba(255, 69, 58, 0.4);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hotspot-warn-banner {
  background: rgba(255, 159, 10, 0.12);
  border: 0.5px solid rgba(255, 159, 10, 0.35);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.banner-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.banner-text {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1.45;
  flex: 1;
}

/* ================= 灵宠主画板区 (Apple Widget Inset) ================= */
.avatar-card {
  display: flex;
  flex-direction: row;
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 24rpx;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.canvas-wrapper {
  width: 270rpx;
  height: 480rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #000000;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
}

.hud-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pet-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.5rpx;
}

.mood-pill {
  font-size: 20rpx;
  color: #64D2FF;
  background: rgba(100, 210, 255, 0.12);
  border: 0.5px solid rgba(100, 210, 255, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.meta-label {
  color: var(--ios-label-secondary, #8E8E93);
}

.highlight-pink {
  color: #FF375F;
  font-weight: 600;
}

.highlight-cyan {
  color: #64D2FF;
  font-weight: 600;
}

.bar-bg {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.35s cubic-bezier(0.2, 0.9, 0.4, 1);
}

.xp-fill {
  background: linear-gradient(90deg, #FF375F, #FF758C);
}

.energy-fill {
  background: linear-gradient(90deg, #30D158, #64D2FF);
}

.stat-tags {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.stat-tag {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 14rpx;
  padding: 8rpx 10rpx;
  font-size: 20rpx;
  color: #EBEBF5;
  text-align: center;
  font-weight: 500;
}

.touch-guide-tip {
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 8rpx 10rpx;
  font-size: 18rpx;
  color: var(--ios-label-tertiary, #636366);
  text-align: center;
}

/* ================= 甜点工坊快捷通道 (App Store Feature Banner) ================= */
.quick-room-nav {
  width: 100%;
}

.feed-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 55, 95, 0.12), rgba(255, 159, 10, 0.08));
  border: 0.5px solid rgba(255, 55, 95, 0.25);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.12s ease;
}

.feed-banner:active {
  transform: scale(0.985);
}

.room-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF375F;
  display: block;
}

.room-desc {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  display: block;
  margin-top: 4rpx;
}

.room-btn {
  font-size: 22rpx;
  font-weight: 600;
  color: #FF375F;
  background: rgba(255, 55, 95, 0.18);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

/* ================= 心声日记与具身互动卡片 (Apple Notes Card) ================= */
.diary-card, .tamagotchi-card {
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.diary-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFD60A;
}

.diary-link {
  font-size: 20rpx;
  color: var(--ios-blue, #0A84FF);
  cursor: pointer;
}

.diary-bubble {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1.6;
  font-style: italic;
  cursor: pointer;
}

/* ================= 历史对话记忆预览 (iMessage Style) ================= */
.memory-card {
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.memory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.memory-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.memory-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #64D2FF;
}

.memory-badge {
  font-size: 18rpx;
  background: rgba(100, 210, 255, 0.15);
  border: 0.5px solid rgba(100, 210, 255, 0.35);
  color: #64D2FF;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.memory-link {
  font-size: 20rpx;
  color: var(--ios-blue, #0A84FF);
  cursor: pointer;
}

.memory-preview-bubble {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  cursor: pointer;
}

.mem-preview-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.mem-role-tag {
  font-weight: 600;
  flex-shrink: 0;
}

.user-tag {
  color: var(--ios-label-secondary, #8E8E93);
}

.pet-tag {
  color: #64D2FF;
}

.mem-snippet-text {
  color: #FFFFFF;
  word-break: break-all;
}

.pet-answer {
  color: #EBEBF5;
}

.memory-empty-preview {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px dashed rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 22rpx;
  font-size: 22rpx;
  color: var(--ios-label-tertiary, #636366);
  text-align: center;
  cursor: pointer;
}

/* ================= 掌心具身互动区 (Apple Control Center Tactile) ================= */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.section-sub {
  font-size: 20rpx;
  color: var(--ios-label-tertiary, #636366);
  font-weight: 400;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.btn-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 92rpx;
  min-height: 92rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: 0.5px solid rgba(255, 255, 255, 0.1);
  width: 100% !important;
  margin: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.12s cubic-bezier(0.2, 0.9, 0.4, 1), opacity 0.12s ease;
}

.btn-action:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.action-icon {
  font-size: 30rpx;
}

.action-text {
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

/* 具有温润质感的 Apple 风格柔和渐变色 */
.btn-pet   { background: linear-gradient(135deg, rgba(255, 55, 95, 0.35), rgba(255, 117, 140, 0.35)), #2C2C2E; border-color: rgba(255, 55, 95, 0.3); }
.btn-groom { background: linear-gradient(135deg, rgba(100, 210, 255, 0.35), rgba(10, 132, 255, 0.35)), #2C2C2E; border-color: rgba(100, 210, 255, 0.3); }
.btn-play  { background: linear-gradient(135deg, rgba(255, 159, 10, 0.35), rgba(255, 214, 10, 0.35)), #2C2C2E; border-color: rgba(255, 159, 10, 0.3); }
.btn-shake { background: linear-gradient(135deg, rgba(94, 92, 230, 0.35), rgba(191, 90, 242, 0.35)), #2C2C2E; border-color: rgba(94, 92, 230, 0.3); }

.sub-action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10rpx;
}

.btn-sub {
  background: var(--ios-tertiary-bg, #2C2C2E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  color: var(--ios-label-secondary, #8E8E93);
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 16rpx;
  height: 68rpx;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 0;
  transition: all 0.12s ease;
}

.btn-sub:active {
  background: var(--ios-quaternary-bg, #3A3A3C);
  color: #FFFFFF;
}

/* ================= 底部连接与信道控制栏 ================= */
.connect-grid {
  display: flex;
  gap: 12rpx;
}

.btn-connect, .btn-sim {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  min-height: 76rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  color: var(--ios-label-secondary, #8E8E93);
  background: var(--ios-secondary-bg, #1C1C1E);
  width: auto !important;
  margin: 0;
  transition: all 0.15s ease;
}

.btn-active {
  background: var(--ios-blue, #0A84FF);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(10, 132, 255, 0.35);
}

.btn-active-sim {
  background: var(--ios-purple, #BF5AF2);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(191, 90, 242, 0.35);
}

/* ================= 3D 姿态与人形关节动力学控制舱 ================= */
.posture-card {
  background: var(--ios-secondary-bg, #1C1C1E);
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.posture-section {
  background: rgba(255, 255, 255, 0.03);
  border: 0.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.posture-row-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.posture-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF7A8A;
}

.sub-label {
  font-size: 22rpx;
  color: #8E8E93;
}

.posture-stunt-btns {
  display: flex;
  gap: 14rpx;
  margin-top: 6rpx;
}

.btn-stunt {
  flex: 1;
  height: 64rpx;
  min-height: 64rpx;
  background: rgba(255, 122, 138, 0.12);
  border: 0.5px solid rgba(255, 122, 138, 0.35);
  color: #FF7A8A;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: auto !important;
}

.balance-section {
  padding: 16rpx 20rpx;
}

.balance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.balance-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.balance-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #10B981;
}

.balance-desc {
  font-size: 19rpx;
  color: #8E8E93;
}

.joint-section .posture-label {
  color: #00E5FF;
}

.btn-joint-reset {
  font-size: 20rpx;
  color: #8E8E93;
  background: rgba(255, 255, 255, 0.08);
  border: 0.5px solid rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin: 0;
  width: auto !important;
  line-height: 1.4;
}

.joint-picker-box {
  background: rgba(0, 229, 255, 0.08);
  border: 0.5px solid rgba(0, 229, 255, 0.25);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}

.picker-label {
  font-size: 22rpx;
  color: #8E8E93;
}

.picker-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #00E5FF;
}

.joint-slider-wrap {
  margin-top: 6rpx;
}

/* ================= 灵宠与灵方多体舞团编队控制台 ================= */
.swarm-dance-card {
  background: var(--ios-card-bg, #1C1C1E);
  border-radius: 28rpx;
  padding: 24rpx;
  border: 0.5px solid rgba(255, 215, 0, 0.25);
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.08);
}

.swarm-dance-header {
  margin-bottom: 16rpx;
}

.swarm-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.swarm-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFD700;
}

.swarm-status-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #8E8E93;
}

.dancing-active {
  background: rgba(255, 215, 0, 0.2);
  color: #FFD700;
  border: 0.5px solid rgba(255, 215, 0, 0.5);
}

.swarm-sub {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 4rpx;
  display: block;
}

.swarm-dance-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.swarm-dance-btn {
  background: var(--ios-secondary-bg, #2C2C2E);
  border-radius: 20rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  width: 100% !important;
  margin: 0;
  box-sizing: border-box;
  text-align: left;
}

.swarm-dance-btn:active {
  transform: scale(0.98);
}

.swarm-btn-icon {
  font-size: 36rpx;
}

.swarm-btn-text {
  display: flex;
  flex-direction: column;
}

.swarm-btn-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.swarm-btn-meta {
  font-size: 18rpx;
  color: #8E8E93;
  margin-top: 2rpx;
}

.btn-waltz { border-color: rgba(236, 72, 153, 0.3); }
.btn-zen { border-color: rgba(16, 185, 129, 0.3); }
.btn-moonwalk { border-color: rgba(59, 130, 246, 0.3); }
.btn-cyber { border-color: rgba(168, 85, 247, 0.3); }

.btn-ceremony-trigger {
  margin-top: 14rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 165, 0, 0.15));
  border: 0.5px solid #FFD700;
  border-radius: 16rpx;
  color: #FFD700;
  font-size: 22rpx;
  font-weight: 700;
  height: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
}

/* ================= 迪士尼影院级动作姿态控制台 ================= */
.cinematic-card {
  background: var(--ios-card-bg, rgba(28, 28, 30, 0.85));
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--ios-radius-card, 32rpx);
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}

.cinematic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cinematic-title-group {
  display: flex;
  flex-direction: column;
}

.cinematic-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cinematic-sub {
  font-size: 20rpx;
  color: var(--ios-label-secondary, #8E8E93);
  margin-top: 4rpx;
}

.cinematic-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFD700;
  background: rgba(255, 215, 0, 0.12);
  border: 0.5px solid rgba(255, 215, 0, 0.3);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.demo-active-badge {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.15);
  border-color: rgba(255, 59, 48, 0.4);
  animation: pulse-glow 1.5s infinite;
}

.cinematic-ctl-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.btn-cine-ctl {
  flex: 1;
  height: 68rpx;
  min-height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #2C2C2E;
  color: #FFFFFF;
  border: 0.5px solid rgba(255, 255, 255, 0.1);
  margin: 0;
  width: auto !important;
}

.btn-demo-on {
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.25), rgba(255, 69, 58, 0.15));
  border-color: #FF3B30;
  color: #FF453A;
}

.btn-step {
  background: linear-gradient(135deg, rgba(10, 132, 255, 0.2), rgba(94, 92, 230, 0.2));
  border-color: rgba(10, 132, 255, 0.4);
}

.actions-scroll-view {
  width: 100%;
  white-space: nowrap;
}

.action-chips-wrapper {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.action-chip {
  display: flex;
  flex-direction: column;
  width: 170rpx;
  flex-shrink: 0;
  background: #242426;
  border: 0.5px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 16rpx 14rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.action-chip:active {
  transform: scale(0.96);
}

.chip-active {
  background: linear-gradient(145deg, rgba(255, 122, 138, 0.25), rgba(255, 107, 129, 0.1));
  border-color: #FF7A8A;
  box-shadow: 0 0 16rpx rgba(255, 122, 138, 0.3);
}

.chip-locked {
  opacity: 0.55;
  filter: grayscale(0.5);
}

.chip-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.chip-icon {
  font-size: 32rpx;
}

.chip-lvl {
  font-size: 16rpx;
  font-weight: 700;
  color: #8E8E93;
  background: rgba(255, 255, 255, 0.08);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.lvl-unlocked {
  color: #34C759;
  background: rgba(52, 199, 89, 0.15);
}

.chip-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.chip-desc {
  font-size: 16rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

