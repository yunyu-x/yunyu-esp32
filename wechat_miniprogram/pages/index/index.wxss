.cadet-director-card {
  background: var(--ios-card-bg, rgba(28, 28, 30, 0.85));
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid rgba(255, 149, 0, 0.25);
  border-radius: var(--ios-radius-card, 32rpx);
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}

.cadet-director-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
