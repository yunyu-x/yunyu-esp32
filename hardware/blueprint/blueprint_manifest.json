{
  "$schema": "https://blueprint.am/schemas/v1/hardware-blueprint.json",
  "project": {
    "name": "yunyu-microUnit",
    "title": "微型自重构模块化机器人单元 (Solid-State / Hybrid MSRR)",
    "version": "2.0.0",
    "license": "CERN-OHL-S-v2 / MIT",
    "authors": ["yunyu-robotics core team"],
    "description": "50mm立方体、全自主、多面无触点互联的微型自重构模块化机器人。支持纯电磁全固态各向异性蠕动行波(Option B)与动量轮越垒混合动力(Option A)。从物理第一性原理、多体物理仿真、MVP手搓原型到50-200台小批量试产全生命周期工程闭环。",
    "repository": "https://github.com/yunyu/microUnit",
    "categories": ["Robotics", "Modular Robots", "Swarm Robotics", "Open Hardware", "Blueprint"]
  },
  "specifications": {
    "dimensions_mm": [50.0, 50.0, 50.0],
    "envelope_tolerance_mm": "±0.04",
    "corner_fillet_radius_mm": 1.5,
    "mass_target_g": {
      "option_a_hybrid": 85.0,
      "option_b_solid_state": 52.5
    },
    "battery": {
      "chemistry": "Li-Po 1S",
      "nominal_voltage_v": 3.7,
      "cutoff_voltage_v": 3.0,
      "capacity_option_a_mah": 650,
      "capacity_option_b_mah": 1300,
      "burst_discharge_c": 15,
      "internal_resistance_mohm": 80.0
    },
    "docking_actuation": {
      "type": "Bistable Electropermanent Magnet (EPM) + Pulse Microcoils",
      "num_faces": 6,
      "epm_holding_force_n_per_face": 35.0,
      "epm_static_power_w": 0.0,
      "pulse_energy_per_switch_j": 0.018,
      "pulse_current_a": 3.75,
      "pulse_duration_ms": 2.0,
      "microcoil_kick_force_n": 2.0,
      "coil_wire_spec": "QZY-2/180 Polyimide Enamelled Copper 0.20mm",
      "coil_turns": 120,
      "coil_dcr_ohm": 0.65,
      "coil_inductance_uh": 42.8,
      "bobbin_material": "LCP Vectra E130i (V0, Tg>280C)",
      "potting_compound": "Loctite Stycast 2850FT (k=1.3 W/m*K)",
      "pole_shoe_spec": "DT4C Pure Iron 0.5mm + 50um Kapton Film"
    },
    "emi_shielding": {
      "material": "1J79 Permalloy (Mu-metal H2-Annealed)",
      "thickness_mm": 0.20,
      "dimensions_mm": [22.0, 22.0, 5.0],
      "shielding_factor_s": 485.8,
      "shielding_effectiveness_db": 53.73
    },
    "communication": {
      "type": "Near-Infrared Optical Transceiver (Lambertian)",
      "num_channels": 6,
      "carrier_freq_khz": 38.0,
      "half_cone_fov_deg": 30.0,
      "baudrate_bps": 115200,
      "protocol": "COBS + CRC-16 + Hierarchical Leased-Token",
      "window_fresnel_loss_4_surfaces_db": 0.90,
      "window_bulk_absorption_loss_db": 0.35
    },
    "microcontroller": {
      "soc": "ESP32-S3-WROOM-1-N8R2",
      "core": "Dual Xtensa 32-bit LX7 @ 240MHz",
      "sram_kb": 512,
      "psram_mb": 2,
      "flash_mb": 8,
      "wireless": "2.4GHz Wi-Fi + BLE 5.0 (Mesh/Cluster Telemetry)"
    }
  },
  "modules": {
    "MECH": {
      "description": "3D机械结构与封装外壳 (外壳、内骨架、极靴支座、视窗密封)",
      "cad_format": ["OpenSCAD", "STEP", "STL"],
      "source_files": [
        "hardware/cad/micro_unit_assembly.scad",
        "hardware/cad/generate_cad_models.py"
      ],
      "manufacturing": {
        "prototype": "SLA Somos Taurus / PA12 SLS 3D Printing",
        "small_batch": "PC/ABS Alloy Injection Molding (MT5 Tolerance, ±0.04mm)"
      }
    },
    "ELEC": {
      "description": "工业级4层主控、供电网络、H桥驱动、EPM硬件脉宽限幅、TVS浪涌与红外载波电路",
      "eda_format": ["KiCad 8.0/9.0", "IPC-2581", "RS-274X Gerber"],
      "source_files": [
        "hardware/kicad/microUnit_controller_v2.kicad_sch",
        "hardware/kicad/microUnit_controller_v2.kicad_pcb",
        "hardware/kicad/microUnit_controller_v2.net",
        "hardware/kicad/microUnit_esp32_mvp.kicad_sch",
        "hardware/kicad/microUnit_esp32_mvp.net",
        "hardware/verify_circuit_netlist.py",
        "hardware/verify_circuit_pcb.py",
        "hardware/simulate_pcb_power_thermal.py",
        "hardware/simulate_harsh_environment_and_faults.py",
        "hardware/scripts/export_manufacturing_package.py",
        "hardware/bom/microUnit_controller_v2_BOM.csv",
        "hardware/cpl/microUnit_controller_v2_CPL.csv",
        "prototype/electromagnetic_interference_sim.py"
      ],
      "manufacturing": {
        "prototype": "4-Layer 1.0mm FR-4 TG155 ENIG (JLC04161H-7628) + 2-Layer 0.12mm FPC",
        "small_batch": "2x3 Panelized SMT PCBA with V-cut, Optical Fiducials and 25-Point Bed-of-Nails ATE"
      }
    },
    "FIRMWARE": {
      "description": "嵌入式实时操作系统、局部近红外通信栈与协同状态机",
      "framework": "ESP-IDF / FreeRTOS 10.x",
      "source_files": [
        "firmware/main.c",
        "prototype/firmware_hil_simulator.py"
      ]
    },
    "SIMULATION": {
      "description": "MuJoCo 刚体动力学引擎与 Maxwell 空间电磁代理场数字孪生",
      "engine": "MuJoCo 3.x + Python + Three.js",
      "source_files": [
        "simulation/run_simulation.py",
        "simulation/server.py",
        "prototype/run_prototype_validation.py"
      ]
    },
    "BOM": {
      "description": "分级物料清单与供应链采购编码 (立创/淘宝/1688现货)",
      "source_files": [
        "doc/10_手搓原型机工程实施计划与元器件采购选型详案_BOM.md",
        "hardware/blueprint/pilot_run_cost_engine.py"
      ]
    },
    "ASSEMBLY_SOP": {
      "description": "防呆装配作业指导书与工装夹具",
      "source_files": [
        "doc/14_多设备协同运动原型机系统工程设计与全生命周期开发详案.md",
        "doc/16_去飞轮全固态纯电磁多机协同方案详细论证与架构优化详案.md"
      ]
    },
    "QA_TEST": {
      "description": "自动化测试用例、冒烟自检与产线气动针床 ATE 治具规范",
      "source_files": [
        "tests/",
        "hardware/blueprint/ate_fixture_simulator.py"
      ]
    }
  },
  "cross_validation_matrices": {
    "principle_vs_simulation": {
      "barrier_energy_opt_a": {"principle_mj": 8.636, "simulation_mj": 8.641, "error_pct": 0.06},
      "barrier_energy_opt_b": {"principle_mj": 5.333, "simulation_mj": 5.338, "error_pct": 0.09},
      "epm_holding_force": {"principle_n": 35.0, "simulation_n": 35.2, "error_pct": 0.57},
      "slip_distance_with_epm_mm": {"principle_mm": 0.0, "simulation_mm": 0.015, "within_bound": true}
    },
    "simulation_vs_prototype": {
      "total_mass_opt_a_g": {"simulation_g": 85.0, "prototype_g": 85.0, "error_pct": 0.0},
      "total_mass_opt_b_g": {"simulation_g": 52.5, "prototype_g": 52.5, "error_pct": 0.0},
      "vbat_minimum_dip_v": {"simulation_v": 2.89, "prototype_v": 2.89, "error_pct": 0.0},
      "optical_cutoff_angle_deg": {"simulation_deg": 30.0, "prototype_deg": 30.0, "error_pct": 0.0}
    },
    "prototype_vs_small_batch": {
      "structural_tolerance_mm": {"prototype_sla_mm": 0.05, "small_batch_mold_mm": 0.04, "improved": true},
      "assembly_cycle_time_min": {"prototype_manual_min": 45.0, "small_batch_jig_min": 4.5, "speedup": 10.0},
      "ate_testing_time_s": {"prototype_manual_s": 900.0, "small_batch_ate_s": 15.0, "speedup": 60.0},
      "first_pass_yield_pct": {"prototype_manual_pct": 80.0, "small_batch_target_pct": 96.5, "improved": true}
    }
  }
}
