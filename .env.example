# ==============================================================================
# M5StickS3 LingBuddy 环境变量配置模板 (Environment Template)
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 填写您的阿里云百炼 (DashScope Realtime) API 密钥与设备 IP/串口
# 3. 严禁将包含真实密钥的 .env 文件提交至远程仓库 (已被 .gitignore 永久忽略)
# ==============================================================================

# 阿里云百炼 DashScope 实时全双工语音 API-Key (sk-...)
BAILIAN_API_KEY=your_dashscope_api_key_here

# M5Stack StickS3 局域网在线 IP 地址
STICK_DEVICE_IP=192.168.110.67

# 宿主机物理硬件连接串口号
STICK_COM_PORT=COM3
BAUD_RATE=115200
